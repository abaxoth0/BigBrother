<UserControl x:Class="frontend.AppearanceEditor"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:local="clr-namespace:frontend">
    <GroupBox Header="Внешний вид" Margin="0,0,0,10" Padding="10"
              DataContext="{x:Static local:AppearanceSettings.Current}">
        <StackPanel>
            <TextBlock Text="Базовый размер шрифта"/>
            <WrapPanel Margin="0,8,0,0">
                <Button x:Name="DecreaseFontSizeButton" Content="−" Click="Decrease_Click"
                        IsEnabled="{Binding CanDecreaseFontSize}" MinWidth="{DynamicResource Scaled40}" Padding="10,4"
                        AutomationProperties.Name="Уменьшить размер шрифта"/>
                <TextBox x:Name="FontSizeInput" Margin="6,0" Width="{DynamicResource Scaled46}"
                         Text="{Binding BaseFontSize, Mode=TwoWay, UpdateSourceTrigger=Explicit}"
                         TextAlignment="Center" VerticalContentAlignment="Center" Padding="8,4"
                         LostFocus="FontSizeInput_LostFocus" PreviewKeyDown="FontSizeInput_PreviewKeyDown"
                         ToolTip="От 10 до 28 px. Enter — применить, ↑/↓ — изменить размер."
                         AutomationProperties.Name="Базовый размер шрифта"/>
                <Button x:Name="IncreaseFontSizeButton" Content="+" Click="Increase_Click"
                        IsEnabled="{Binding CanIncreaseFontSize}" MinWidth="{DynamicResource Scaled40}" Padding="10,4"
                        AutomationProperties.Name="Увеличить размер шрифта"/>
                <TextBlock Text="px" VerticalAlignment="Center" Margin="8,0,0,0"/>
            </WrapPanel>
            <TextBlock Text="От 10 до 28 px. Все размеры текста меняются пропорционально. Изменения применяются сразу."
                       TextWrapping="Wrap" Foreground="{DynamicResource TextDim}" Margin="0,8,0,0"/>
            <WrapPanel Margin="0,8,0,0">
                <Button Content="По умолчанию (14 px)" Click="Reset_Click" Margin="0,0,8,0"/>
                <Button Content="Сохранить" Click="Save_Click"/>
            </WrapPanel>
            <TextBlock Text="{Binding Status}" TextWrapping="Wrap" Margin="0,8,0,0"/>
        </StackPanel>
    </GroupBox>
</UserControl>
