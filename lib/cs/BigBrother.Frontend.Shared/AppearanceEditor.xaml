<UserControl x:Class="frontend.AppearanceEditor"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:local="clr-namespace:frontend"
             xmlns:services="clr-namespace:frontend.Services">
    <GroupBox Header="Внешний вид" Margin="0,0,0,10" Padding="10"
              DataContext="{x:Static local:AppearanceSettings.Current}">
        <StackPanel>
            <TextBlock Text="Базовый размер шрифта"/>
            <DockPanel Margin="0,8,0,0">
                <TextBlock DockPanel.Dock="Right" Text="{Binding BaseFontSize, StringFormat={}{0} px}"
                           MinWidth="60" TextAlignment="Right" VerticalAlignment="Center"/>
                <Slider Minimum="{x:Static services:AppearancePreferences.MinimumFontSize}"
                        Maximum="{x:Static services:AppearancePreferences.MaximumFontSize}"
                        Value="{Binding BaseFontSize, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                        TickFrequency="1" IsSnapToTickEnabled="True" SmallChange="1" LargeChange="2"
                        AutomationProperties.Name="Базовый размер шрифта"/>
            </DockPanel>
            <TextBlock Text="От 10 до 28 px. Все размеры текста меняются пропорционально. Изменения применяются сразу."
                       TextWrapping="Wrap" Foreground="{DynamicResource TextDim}" Margin="0,8,0,0"/>
            <WrapPanel Margin="0,8,0,0">
                <Button Content="По умолчанию (14 px)" Click="Reset_Click" Margin="0,0,8,0"/>
                <Button Content="Сохранить" Click="Save_Click"/>
            </WrapPanel>
            <TextBlock Text="{Binding Status}" TextWrapping="Wrap" Margin="0,8,0,0"/>
        </StackPanel>
    </GroupBox>
</UserControl>
