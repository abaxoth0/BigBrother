<UserControl x:Class="frontend.SettingsBrowser"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:local="clr-namespace:frontend"
             x:Name="BrowserRoot">
    <UserControl.Content>
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>
            <StackPanel Margin="0,0,0,16">
                <Button x:Name="BackButton" Content="Все категории" HorizontalAlignment="Left"
                        Margin="0,0,0,12" Click="Back_Click" Visibility="Collapsed"/>
                <TextBlock x:Name="PageTitle" Text="Настройки" FontSize="{DynamicResource FontSize22}"
                           FontWeight="SemiBold" TextWrapping="Wrap"/>
                <TextBlock x:Name="OverviewHint" Text="Выберите категорию настроек."
                           Foreground="{DynamicResource TextDim}" TextWrapping="Wrap" Margin="0,6,0,0"/>
                <TextBlock x:Name="PendingHint" Text="Есть несохранённые изменения настроек."
                           Foreground="{DynamicResource TextDim}" TextWrapping="Wrap" Margin="0,6,0,0"
                           Visibility="Collapsed"/>
            </StackPanel>
            <ScrollViewer x:Name="PageScroll" Grid.Row="1" VerticalScrollBarVisibility="Auto"
                          HorizontalScrollBarVisibility="Disabled">
                <Grid>
                    <ItemsControl x:Name="CategoryList">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Button Tag="{Binding}" Click="Category_Click" Margin="0,0,0,10"
                                        Padding="16,12" HorizontalContentAlignment="Stretch"
                                        AutomationProperties.Name="{Binding Title}">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>
                                        <StackPanel>
                                            <TextBlock Text="{Binding Title}" FontSize="{DynamicResource FontSize17}"
                                                       FontWeight="SemiBold" TextWrapping="Wrap"/>
                                            <TextBlock Text="{Binding Description}" Foreground="{DynamicResource TextDim}"
                                                       TextWrapping="Wrap" Margin="0,6,0,0"/>
                                        </StackPanel>
                                        <Path Grid.Column="1" Data="M 0,0 L 5,5 L 0,10" Stroke="{DynamicResource TitleBarText}"
                                              StrokeThickness="1.5" VerticalAlignment="Center" Margin="20,0,0,0"/>
                                    </Grid>
                                </Button>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                    <StackPanel x:Name="CategoryHost" Visibility="Collapsed"/>
                </Grid>
            </ScrollViewer>
            <Border x:Name="SaveFooter" Grid.Row="2" Padding="0,12,0,0">
                <StackPanel>
                    <TextBlock Text="{Binding Status, Source={x:Static local:AppearanceSettings.Current}}"
                               Foreground="{DynamicResource TextDim}" TextWrapping="Wrap"/>
                    <Button x:Name="SaveButton" Content="Сохранить настройки"
                            Command="{Binding SaveAllCommand, ElementName=BrowserRoot}"
                            Style="{StaticResource PrimaryButton}" HorizontalAlignment="Right"/>
                </StackPanel>
            </Border>
        </Grid>
    </UserControl.Content>
</UserControl>
