#include <windows.h>
#include "version.h"

1 VERSIONINFO
FILEVERSION BB_VERSION_TUPLE
PRODUCTVERSION BB_VERSION_TUPLE
FILEFLAGSMASK VS_FFI_FILEFLAGSMASK
FILEFLAGS 0
FILEOS VOS_NT_WINDOWS32
FILETYPE VFT_APP
FILESUBTYPE 0
BEGIN
    BLOCK "StringFileInfo"
    BEGIN
        BLOCK "040904b0"
        BEGIN
            VALUE "FileDescription", BB_APP_NAME
            VALUE "FileVersion", BB_VERSION
            VALUE "ProductName", "BigBrother"
            VALUE "ProductVersion", BB_VERSION
        END
    END
    BLOCK "VarFileInfo"
    BEGIN
        VALUE "Translation", 0x0409, 1200
    END
END
