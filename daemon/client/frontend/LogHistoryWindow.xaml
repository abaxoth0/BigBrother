<Window x:Class="frontend.LogHistoryWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="История логов" Height="600" Width="900"
        WindowStartupLocation="CenterOwner">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>
        
        <!-- Toolbar -->
        <Grid Grid.Row="0" Margin="10,10,10,5">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            
            <TextBox Grid.Column="0" x:Name="SearchTextBox" 
                     Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}"
                     VerticalContentAlignment="Center"
                     Margin="0,0,10,0"/>
            
            <Button Grid.Column="1" Content="Перезагрузить" 
                    Click="Reload_Click" Margin="0,0,5,0" Padding="10,5"/>
            <Button Grid.Column="2" Content="Экспорт" 
                    Click="Export_Click" Margin="0,0,5,0" Padding="10,5"/>
            <Button Grid.Column="3" Content="Закрыть" 
                    Click="Close_Click" Padding="10,5"/>
        </Grid>
        
        <!-- Tabs with logs -->
        <TabControl Grid.Row="1" x:Name="LogTabs" Margin="10,5,10,10">
            <TabItem x:Name="FirewallTab" Header="Firewall">
                <ListBox x:Name="FirewallListBox"
                         FontFamily="Consolas" FontSize="12"
                         VirtualizingPanel.IsVirtualizing="True">
                    <ListBox.ItemTemplate>
                        <DataTemplate>
                            <TextBlock Text="{Binding Message}"/>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>
            </TabItem>
            <TabItem x:Name="ClientTab" Header="Client">
                <ListBox x:Name="ClientListBox"
                         FontFamily="Consolas" FontSize="12"
                         VirtualizingPanel.IsVirtualizing="True">
                    <ListBox.ItemTemplate>
                        <DataTemplate>
                            <TextBlock Text="{Binding Message}"/>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>
            </TabItem>
        </TabControl>
        
        <!-- Status bar -->
        <TextBlock Grid.Row="2" x:Name="StatusText" 
                   Margin="10,5,10,10" VerticalAlignment="Center"/>
    </Grid>
</Window>