<Window x:Class="frontend.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:frontend"
        xmlns:vm="clr-namespace:frontend.ViewModels"
        xmlns:conv="clr-namespace:frontend.Converters"
        mc:Ignorable="d"
        Title="Big Brother Клиент" 
        Height="700" Width="1000" 
        MinHeight="500" MinWidth="800"
        Background="White"
        WindowStartupLocation="CenterScreen">
    
    <Window.DataContext>
        <vm:MainViewModel/>
    </Window.DataContext>
    
    <Window.Resources>
        <conv:ConnectionStatusToColorConverter x:Key="ConnectionStatusToColor"/>
        
        <!-- Colors -->
        <SolidColorBrush x:Key="BorderBrush" Color="#CCCCCC"/>
        <SolidColorBrush x:Key="HeaderBackground" Color="#F0F0F0"/>
        <SolidColorBrush x:Key="StatusRunning" Color="#4CAF50"/>
        <SolidColorBrush x:Key="StatusStopped" Color="#F44336"/>
        <SolidColorBrush x:Key="StatusWarning" Color="#FF9800"/>
        <SolidColorBrush x:Key="LogBackground" Color="#1E1E1E"/>
        
        <!-- Log Level Colors -->
        <SolidColorBrush x:Key="LogInfo" Color="#D4D4D4"/>
        <SolidColorBrush x:Key="LogWarning" Color="#FFA500"/>
        <SolidColorBrush x:Key="LogError" Color="#FF6B6B"/>
        <SolidColorBrush x:Key="LogDns" Color="#6B9FFF"/>
        <SolidColorBrush x:Key="LogBlocked" Color="#FF4444"/>
        
        <!-- Button Style -->
        <Style x:Key="ControlButton" TargetType="Button">
            <Setter Property="Padding" Value="12,6"/>
            <Setter Property="Margin" Value="2"/>
            <Setter Property="MinWidth" Value="70"/>
        </Style>
        
        <!-- Connection Status Style -->
        <Style x:Key="ConnectionText" TargetType="TextBlock">
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Foreground" Value="{Binding DaemonConnectionStatus, Converter={StaticResource ConnectionStatusToColor}}"/>
        </Style>
    </Window.Resources>
    
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>
        
        <!-- Menu Bar -->
        <Menu Grid.Row="0" Background="{StaticResource HeaderBackground}">
            <MenuItem Header="_Файл">
                <MenuItem Header="_Экспорт логов..." Command="{Binding ExportLogsCommand}"/>
                <Separator/>
                <MenuItem Header="_Выход"/>
            </MenuItem>
            <MenuItem Header="_Вид">
                <MenuItem Header="_Обновить"/>
            </MenuItem>
        </Menu>
        
        <!-- Tab Control -->
        <TabControl Grid.Row="1" Margin="5">
            
            <!-- TAB 1: Main -->
            <TabItem Header="Главная">
                <Grid Margin="5">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>
                    
                    <!-- Logs Section (Top) -->
                    <Grid Grid.Row="0">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="250" MinHeight="100"/>
                        </Grid.RowDefinitions>
                        
                        <!-- Logs Header -->
                        <Grid Grid.Row="0" Background="{StaticResource HeaderBackground}" Margin="0,0,0,2">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            
                            <TextBlock Grid.Column="0" Text="ЛОГИ" FontWeight="Bold" 
                                       VerticalAlignment="Center" Margin="10,5"/>
                            
                            <TextBlock Grid.Column="1" Text="{Binding LastUpdateFormatted}" 
                                       Foreground="Gray" VerticalAlignment="Center" Margin="10,5,0,0"/>
                            
                            <CheckBox Grid.Column="2" Content="Авто-скролл" 
                                      IsChecked="{Binding AutoScroll}"
                                      VerticalAlignment="Center" Margin="15,5,5,5"/>
                            
                            <StackPanel Grid.Column="4" Orientation="Horizontal" Margin="5">
                                <TextBox Width="150" Margin="5" 
                                         Text="{Binding LogSearchText, UpdateSourceTrigger=PropertyChanged}"
                                         VerticalContentAlignment="Center"/>
                            </StackPanel>
                            
                            <Button Grid.Column="5" Content="Экспорт" Style="{StaticResource ControlButton}" 
                                    Command="{Binding ExportLogsCommand}" Margin="2"/>
                            <Button Grid.Column="6" Content="Очистить" Style="{StaticResource ControlButton}" 
                                    Command="{Binding ClearLogsCommand}" Margin="2"/>
                        </Grid>
                        
                        <!-- Logs ListBox with colored levels -->
                        <ListBox Grid.Row="1" x:Name="LogsListBox"
                                 Background="{StaticResource LogBackground}"
                                 ItemsSource="{Binding FilteredLogs}"
                                 FontFamily="Consolas" FontSize="12"
                                 BorderBrush="{StaticResource BorderBrush}">
                            <ListBox.ItemTemplate>
                                <DataTemplate>
                                    <TextBlock Text="{Binding Message}" 
                                               Foreground="{StaticResource LogInfo}">
                                        <TextBlock.Style>
                                            <Style TargetType="TextBlock">
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding Level}" Value="ERROR">
                                                        <Setter Property="Foreground" Value="{StaticResource LogError}"/>
                                                    </DataTrigger>
                                                    <DataTrigger Binding="{Binding Level}" Value="WARNING">
                                                        <Setter Property="Foreground" Value="{StaticResource LogWarning}"/>
                                                    </DataTrigger>
                                                    <DataTrigger Binding="{Binding Level}" Value="DNS">
                                                        <Setter Property="Foreground" Value="{StaticResource LogDns}"/>
                                                    </DataTrigger>
                                                    <DataTrigger Binding="{Binding Level}" Value="BLOCKED">
                                                        <Setter Property="Foreground" Value="{StaticResource LogBlocked}"/>
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </TextBlock.Style>
                                    </TextBlock>
                                </DataTemplate>
                            </ListBox.ItemTemplate>
                        </ListBox>
                    </Grid>
                    
                    <!-- Control Panel Section (Bottom) -->
                    <Border Grid.Row="1" BorderBrush="{StaticResource BorderBrush}" 
                            BorderThickness="1" Margin="0,5,0,0" Padding="10">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                            </Grid.RowDefinitions>
                            
                            <TextBlock Grid.Row="0" Text="ПАНЕЛЬ УПРАВЛЕНИЯ" FontWeight="Bold" 
                                       Margin="0,0,0,10"/>
                            
                            <Grid Grid.Row="1">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                
                                <!-- Firewall Control -->
                                <StackPanel Grid.Column="0">
                                    <StackPanel Orientation="Horizontal" Margin="0,5">
                                        <TextBlock Text="Firewall:" Width="80" FontWeight="SemiBold" VerticalAlignment="Center"/>
                                        <Ellipse Width="12" Height="12" 
                                                 Fill="{StaticResource StatusRunning}"
                                                 VerticalAlignment="Center"/>
                                        <TextBlock Text="{Binding DaemonStatus}" 
                                                   Margin="5,0" VerticalAlignment="Center"/>
                                        <TextBlock Text="{Binding DaemonPid, StringFormat='(PID: {0})'}"
                                                   Foreground="Gray" VerticalAlignment="Center"/>
                                    </StackPanel>
                                    <StackPanel Orientation="Horizontal" Margin="0,5">
                                        <TextBlock Text="Соединение:" Width="100" Foreground="Gray" VerticalAlignment="Center"/>
                                        <TextBlock Text="{Binding DaemonConnectionStatus}" 
                                                   Style="{StaticResource ConnectionText}"/>
                                    </StackPanel>
                                    <StackPanel Orientation="Horizontal" Margin="0,5">
                                        <Button Content="Стоп" Style="{StaticResource ControlButton}"/>
                                        <Button Content="Рестарт" Style="{StaticResource ControlButton}"/>
                                    </StackPanel>
                                </StackPanel>
                                
                                <!-- Client Control -->
                                <StackPanel Grid.Column="1">
                                    <StackPanel Orientation="Horizontal" Margin="0,5">
                                        <TextBlock Text="Клиент:" Width="80" FontWeight="SemiBold" VerticalAlignment="Center"/>
                                        <Ellipse Width="12" Height="12" 
                                                 Fill="{StaticResource StatusRunning}"
                                                 VerticalAlignment="Center"/>
                                        <TextBlock Text="{Binding ClientStatus}" 
                                                   Margin="5,0" VerticalAlignment="Center"/>
                                        <TextBlock Text="{Binding ClientPid, StringFormat='(PID: {0})'}"
                                                   Foreground="Gray" VerticalAlignment="Center"/>
                                    </StackPanel>
                                    <StackPanel Orientation="Horizontal" Margin="0,5">
                                        <TextBlock Text="Соединение:" Width="100" Foreground="Gray" VerticalAlignment="Center"/>
                                        <TextBlock Text="{Binding ClientConnectionStatus}" 
                                                   Style="{StaticResource ConnectionText}"/>
                                    </StackPanel>
                                    <StackPanel Orientation="Horizontal" Margin="0,5">
                                        <Button Content="Стоп" Style="{StaticResource ControlButton}"/>
                                        <Button Content="Рестарт" Style="{StaticResource ControlButton}"/>
                                    </StackPanel>
                                </StackPanel>
                            </Grid>
                        </Grid>
                    </Border>
                </Grid>
            </TabItem>
            
            <!-- TAB 2: Whitelist -->
            <TabItem Header="Белый список">
                <Grid Margin="5">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>
                    
                    <Grid Grid.Row="0" Background="{StaticResource HeaderBackground}" Margin="0,0,0,5">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        
                        <TextBlock Grid.Column="0" FontWeight="Bold" Margin="10,5" VerticalAlignment="Center">
                            <Run Text="БЕЛЫЙ СПИСОК ("/>
                            <Run Text="{Binding WhitelistCount}"/>
                            <Run Text=" доменов)"/>
                        </TextBlock>
                        
                        <TextBox Grid.Column="1" Margin="10,5" 
                                 Text="{Binding WhitelistSearchText, UpdateSourceTrigger=PropertyChanged}"
                                 VerticalContentAlignment="Center"/>
                        
                        <StackPanel Grid.Column="3" Orientation="Horizontal" Margin="5" VerticalAlignment="Center">
                            <TextBlock Text="Формат:" VerticalAlignment="Center" Margin="0,0,5,0"/>
                            <ComboBox Width="150" SelectedIndex="1">
                                <ComboBoxItem Content="Красивый"/>
                                <ComboBoxItem Content="Исходный"/>
                            </ComboBox>
                        </StackPanel>
                        
                        <Button Grid.Column="4" Content="Обновить" 
                                Style="{StaticResource ControlButton}" Margin="5"/>
                    </Grid>
                    
                    <ListBox Grid.Row="1" ItemsSource="{Binding FilteredWhitelist}"
                             BorderBrush="{StaticResource BorderBrush}"
                             FontFamily="Segoe UI" FontSize="13"
                             ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <StackPanel Orientation="Horizontal" Margin="5,8">
                                    <Ellipse Width="8" Height="8" 
                                             Fill="{StaticResource StatusRunning}"
                                             VerticalAlignment="Center" Margin="0,0,15,0"/>
                                    <TextBlock Text="{Binding}" TextWrapping="Wrap"/>
                                </StackPanel>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>
                </Grid>
            </TabItem>
            
            <!-- TAB 3: Settings -->
            <TabItem Header="Настройки">
                <Grid Margin="10">
                    <TextBlock Text="Настройки (Скоро)" 
                               FontSize="18" Foreground="Gray"
                               HorizontalAlignment="Center" 
                               VerticalAlignment="Center"/>
                </Grid>
            </TabItem>
            
        </TabControl>
    </Grid>
</Window>
