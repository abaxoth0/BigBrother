<Window x:Class="frontend.LogViewWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Просмотр логов" Height="600" Width="900"
        WindowStartupLocation="CenterOwner">
    <Window.Resources>
        <DataTemplate x:Key="LogLineTemplate">
            <TextBlock Text="{Binding Message}" FontFamily="Consolas" FontSize="12"/>
        </DataTemplate>
    </Window.Resources>
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>
        
        <!-- Toolbar -->
        <Grid Grid.Row="0" Margin="10,10,10,5">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            
            <TextBox Grid.Column="0" x:Name="SearchTextBox" 
                     VerticalContentAlignment="Center"
                     Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}"
                     Margin="0,0,10,0"/>
            
            <Button Grid.Column="1" Content="Перезагрузить" 
                    Command="{Binding ReloadCommand}" Margin="0,0,5,0" Padding="10,5"/>
            <Button Grid.Column="2" Content="Экспорт" 
                    Command="{Binding ExportCommand}" Margin="0,0,5,0" Padding="10,5"/>
            <Button Grid.Column="3" Content="Закрыть" 
                    Command="{Binding CloseCommand}" Padding="10,5"/>
        </Grid>
        
        <!-- Tabs with logs -->
        <TabControl Grid.Row="1" x:Name="LogTabs" Margin="10,5,10,10"/>
        
        <!-- Status bar -->
        <TextBlock Grid.Row="2" x:Name="StatusText" 
                   Margin="10,5,10,10" VerticalAlignment="Center"/>
    </Grid>
</Window>
