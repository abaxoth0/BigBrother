<local:ChromeWindow x:Class="frontend.LogViewWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:frontend;assembly=BigBrother.Frontend.Shared"
        xmlns:shell="clr-namespace:System.Windows.Shell;assembly=PresentationFramework"
        Title="Просмотр логов" Height="600" Width="900"
        WindowStartupLocation="CenterOwner"
        Background="{StaticResource WindowBackground}"
        Foreground="{StaticResource TitleBarText}"
        WindowStyle="None">
    <shell:WindowChrome.WindowChrome>
        <shell:WindowChrome CaptionHeight="42" ResizeBorderThickness="6"
                            GlassFrameThickness="0" UseAeroCaptionButtons="False"/>
    </shell:WindowChrome.WindowChrome>
    <Window.Resources>
        <DataTemplate x:Key="LogLineTemplate">
            <TextBlock Text="{Binding Message}" FontFamily="Consolas" FontSize="12"/>
        </DataTemplate>
    </Window.Resources>
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- Custom Title Bar -->
        <Border Grid.Row="0" Background="{StaticResource TitleBarBackground}"
                BorderBrush="{StaticResource BorderBrush}" BorderThickness="0,0,0,1">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <TextBlock Grid.Column="0" Text="Просмотр логов" Foreground="{StaticResource TitleBarText}"
                           FontSize="13" FontWeight="SemiBold" VerticalAlignment="Center" Margin="14,0,0,0"/>

                <StackPanel Grid.Column="2" Orientation="Horizontal">
                    <Button Content="&#x2013;"
                            Style="{StaticResource TitleBarButton}"
                            shell:WindowChrome.IsHitTestVisibleInChrome="True"
                            Click="MinimizeButton_Click"/>
                    <Button Content="&#x2715;"
                            Style="{StaticResource TitleBarButton}"
                            Tag="Close"
                            shell:WindowChrome.IsHitTestVisibleInChrome="True"
                            Click="CloseButton_Click"/>
                </StackPanel>
            </Grid>
        </Border>

        <Grid Grid.Row="1">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <!-- Toolbar -->
            <Grid Grid.Row="0" Margin="10,10,10,5">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <TextBox Grid.Column="0" x:Name="SearchTextBox"
                         VerticalContentAlignment="Center"
                         Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}"
                         Margin="0,0,10,0"/>

                <Button Grid.Column="1" Content="Перезагрузить"
                        Command="{Binding ReloadCommand}" Margin="0,0,5,0" Padding="10,5"/>
                <Button Grid.Column="2" Content="Экспорт"
                        Command="{Binding ExportCommand}" Margin="0,0,5,0" Padding="10,5"/>
                <Button Grid.Column="3" Content="Закрыть"
                        Command="{Binding CloseCommand}" Padding="10,5"/>
            </Grid>

            <!-- Tabs with logs -->
            <TabControl Grid.Row="1" x:Name="LogTabs" Margin="10,5,10,10"/>

            <!-- Status bar -->
            <TextBlock Grid.Row="2" x:Name="StatusText"
                       Margin="10,5,10,10" VerticalAlignment="Center" Foreground="{StaticResource TitleBarText}"/>
        </Grid>
    </Grid>
</local:ChromeWindow>
