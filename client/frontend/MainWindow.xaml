<local:ChromeWindow x:Class="frontend.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:frontend"
        xmlns:vm="clr-namespace:frontend.ViewModels"
        xmlns:conv="clr-namespace:frontend.Converters;assembly=BigBrother.Frontend.Shared"
        xmlns:shell="clr-namespace:System.Windows.Shell;assembly=PresentationFramework"
        mc:Ignorable="d"
        Title="Big Brother Клиент"
        Height="700" Width="1200"
        MinHeight="500" MinWidth="950"
        Background="{StaticResource WindowBackground}"
        Foreground="{StaticResource TitleBarText}"
        WindowStartupLocation="CenterScreen"
        WindowStyle="None">
    <shell:WindowChrome.WindowChrome>
        <shell:WindowChrome CaptionHeight="42" ResizeBorderThickness="6"
                            GlassFrameThickness="0" UseAeroCaptionButtons="False"/>
    </shell:WindowChrome.WindowChrome>

    <local:ChromeWindow.DataContext>
        <vm:MainViewModel/>
    </local:ChromeWindow.DataContext>

    <Window.Resources>
        <conv:BoolToVisibilityConverter x:Key="BoolToVisibility"/>
        <conv:InverseBoolToVisibilityConverter x:Key="InverseBoolToVisibility"/>
        <conv:EnumToBoolConverter x:Key="EnumToBool"/>

        <!-- Button Style -->
        <Style x:Key="ControlButton" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
            <Setter Property="Padding" Value="12,6"/>
            <Setter Property="Margin" Value="2"/>
            <Setter Property="MinWidth" Value="70"/>
        </Style>
        <Style x:Key="SmallButton" TargetType="Button" BasedOn="{StaticResource ControlButton}">
            <Setter Property="MinWidth" Value="0"/>
            <Setter Property="Padding" Value="8,4"/>
            <Setter Property="FontSize" Value="12"/>
        </Style>

        <!-- Level filter pill -->
        <Style x:Key="FilterToggle" TargetType="ToggleButton">
            <Setter Property="Margin" Value="2"/>
            <Setter Property="Padding" Value="8,4"/>
            <Setter Property="MinWidth" Value="0"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="Background" Value="{StaticResource SurfaceAlt}"/>
            <Setter Property="Foreground" Value="{StaticResource TitleBarText}"/>
            <Setter Property="BorderBrush" Value="{StaticResource BorderBrush}"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ToggleButton">
                        <Border x:Name="Bd" Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="1"
                                CornerRadius="4" Padding="{TemplateBinding Padding}">
                            <ContentPresenter x:Name="Cp" HorizontalAlignment="Center" VerticalAlignment="Center"
                                              TextElement.Foreground="{TemplateBinding Foreground}"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="{StaticResource SurfaceAltHover}"/>
                            </Trigger>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="{StaticResource Accent}"/>
                                <Setter TargetName="Bd" Property="BorderBrush" Value="{StaticResource Accent}"/>
                                <Setter TargetName="Cp" Property="TextElement.Foreground" Value="{StaticResource OnAccent}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Status dot -->
        <Style x:Key="StatusDot" TargetType="Ellipse">
            <Setter Property="Width" Value="12"/>
            <Setter Property="Height" Value="12"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="Fill" Value="{StaticResource StatusDisconnected}"/>
            <Setter Property="Margin" Value="0,0,8,0"/>
        </Style>

        <!-- Right-side nav item -->
        <Style x:Key="NavItem" TargetType="RadioButton">
            <Setter Property="Padding" Value="14,10"/>
            <Setter Property="Margin" Value="0,2"/>
            <Setter Property="Foreground" Value="{StaticResource TitleBarText}"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="RadioButton">
                        <Border x:Name="Bg" Background="{TemplateBinding Background}"
                                CornerRadius="4" Padding="{TemplateBinding Padding}">
                            <ContentPresenter VerticalAlignment="Center" HorizontalAlignment="Stretch"
                                              TextElement.Foreground="{TemplateBinding Foreground}"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bg" Property="Background" Value="{StaticResource SurfaceAlt}"/>
                            </Trigger>
                            <MultiTrigger>
                                <MultiTrigger.Conditions>
                                    <Condition Property="IsChecked" Value="True"/>
                                </MultiTrigger.Conditions>
                                <Setter TargetName="Bg" Property="Background" Value="{StaticResource Accent}"/>
                                <Setter Property="Foreground" Value="{StaticResource OnAccent}"/>
                            </MultiTrigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Custom Title Bar -->
        <Border Grid.Row="0" Background="{StaticResource TitleBarBackground}"
                BorderBrush="{StaticResource BorderBrush}" BorderThickness="0,0,0,1">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <TextBlock Grid.Column="0" Text="Big Brother Клиент" Foreground="{StaticResource TitleBarText}"
                           FontSize="13" FontWeight="SemiBold" VerticalAlignment="Center" Margin="14,0,0,0"/>

                <StackPanel Grid.Column="2" Orientation="Horizontal">
                    <Button Content="&#x2013;"
                            Style="{StaticResource TitleBarButton}"
                            shell:WindowChrome.IsHitTestVisibleInChrome="True"
                            Click="MinimizeButton_Click"/>
                    <Button Content="&#x2715;"
                            Style="{StaticResource TitleBarButton}"
                            Tag="Close"
                            shell:WindowChrome.IsHitTestVisibleInChrome="True"
                            Click="CloseButton_Click"/>
                </StackPanel>
            </Grid>
        </Border>

        <!-- Content + Side Navigation -->
        <Grid Grid.Row="1" Margin="5">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="190"/>
            </Grid.ColumnDefinitions>

            <!-- Content area -->
            <Grid Grid.Column="0" Margin="0,0,8,0">

                <!-- SECTION: Main -->
                <Grid>
                    <Grid.Style>
                        <Style TargetType="Grid">
                            <Setter Property="Visibility" Value="Collapsed"/>
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding SelectedSection}" Value="Main">
                                    <Setter Property="Visibility" Value="Visible"/>
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </Grid.Style>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <!-- Health banner -->
                    <Border Grid.Row="0" CornerRadius="4" Padding="12,8" Margin="0,0,0,8">
                        <Border.Style>
                            <Style TargetType="Border">
                                <Setter Property="Background" Value="{StaticResource StatusWarning}"/>
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding OverallHealth}" Value="AllOk">
                                        <Setter Property="Background" Value="{StaticResource StatusRunning}"/>
                                    </DataTrigger>
                                    <DataTrigger Binding="{Binding OverallHealth}" Value="Critical">
                                        <Setter Property="Background" Value="{StaticResource StatusDisconnected}"/>
                                    </DataTrigger>
                                    <DataTrigger Binding="{Binding OverallHealth}" Value="Unknown">
                                        <Setter Property="Background" Value="{StaticResource TextDim}"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Border.Style>
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="{Binding OverallHealthText}" FontWeight="Bold" Foreground="White"
                                       VerticalAlignment="Center" FontSize="15"/>
                        </StackPanel>
                    </Border>

                    <!-- Logs Section -->
                    <Grid Grid.Row="2">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*" MinHeight="120"/>
                        </Grid.RowDefinitions>

                        <!-- Logs Header -->
                        <Border Grid.Row="0" Background="{StaticResource HeaderBackground}" CornerRadius="4" Margin="0,0,0,2">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>

                            <TextBlock Grid.Column="0" Text="ЛОГИ" FontWeight="Bold"
                                       VerticalAlignment="Center" Margin="10,5"/>

                            <TextBox Grid.Column="1" Height="26" Margin="10,5,5,5"
                                     VerticalContentAlignment="Center"
                                     ToolTip="Поиск по тексту или уровню">
                                <TextBox.Style>
                                    <Style TargetType="TextBox" BasedOn="{StaticResource {x:Type TextBox}}">
                                        <Style.Triggers>
                                            <Trigger Property="Text" Value="">
                                                <Setter Property="Tag" Value="true"/>
                                            </Trigger>
                                        </Style.Triggers>
                                    </Style>
                                </TextBox.Style>
                                <Binding Path="LogSearchText" UpdateSourceTrigger="PropertyChanged"/>
                            </TextBox>

                            <CheckBox Grid.Column="2" Content="Авто-скролл"
                                      IsChecked="{Binding AutoScroll}"
                                      VerticalAlignment="Center" Margin="15,5,5,5"/>

                            <Button Grid.Column="3" Content="К последнему" Style="{StaticResource SmallButton}"
                                    Command="{Binding JumpToBottomCommand}" Margin="2"/>

                            <Button Grid.Column="5" Content="Открыть" Style="{StaticResource ControlButton}"
                                    Command="{Binding OpenArchivedLogCommand}" Margin="2"/>
                            <Button Grid.Column="6" Content="История" Style="{StaticResource ControlButton}"
                                    Command="{Binding OpenHistoryCommand}" Margin="2"/>
                            <Button Grid.Column="7" Content="Экспорт" Style="{StaticResource ControlButton}"
                                    Command="{Binding ExportLogsCommand}" Margin="2"/>
                            <Button Grid.Column="8" Content="Очистить" Style="{StaticResource ControlButton}"
                                    Command="{Binding ClearLogsCommand}" Margin="2"/>
                            </Grid>
                        </Border>

                        <!-- Level filters -->
                        <StackPanel Grid.Row="1" Orientation="Horizontal" Margin="2,4,2,4">
                            <TextBlock Text="Уровень:" VerticalAlignment="Center" Margin="4,0" Foreground="Gray"/>
                            <ToggleButton Content="INFO" Style="{StaticResource FilterToggle}" IsChecked="{Binding ShowInfo}"/>
                            <ToggleButton Content="ERROR" Style="{StaticResource FilterToggle}" IsChecked="{Binding ShowErrors}"/>
                            <ToggleButton Content="WARNING" Style="{StaticResource FilterToggle}" IsChecked="{Binding ShowWarnings}"/>
                            <ToggleButton Content="DNS" Style="{StaticResource FilterToggle}" IsChecked="{Binding ShowDns}"/>
                            <ToggleButton Content="BLOCKED" Style="{StaticResource FilterToggle}" IsChecked="{Binding ShowBlocked}"/>
                        </StackPanel>

                        <!-- Logs ListBox with colored levels -->
                        <ListBox Grid.Row="2" x:Name="LogsListBox"
                                 Background="{StaticResource LogBackground}"
                                 ItemsSource="{Binding FilteredLogs}"
                                 FontFamily="Consolas" FontSize="12"
                                 BorderBrush="{StaticResource BorderBrush}"
                                 VirtualizingPanel.IsVirtualizing="True"
                                 VirtualizingPanel.VirtualizationMode="Recycling">
                            <ListBox.ItemContainerStyle>
                                <Style TargetType="ListBoxItem">
                                    <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
                                    <Setter Property="VerticalContentAlignment" Value="Center"/>
                                    <Setter Property="Padding" Value="4,2"/>
                                </Style>
                            </ListBox.ItemContainerStyle>
                            <ListBox.ItemTemplate>
                                <DataTemplate>
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto"/>
                                            <ColumnDefinition Width="Auto"/>
                                            <ColumnDefinition Width="*"/>
                                        </Grid.ColumnDefinitions>

                                        <TextBlock Grid.Column="0" Text="{Binding Timestamp}"
                                                   Foreground="#8A8A8A" Margin="0,0,10,0"/>
                                        <Border Grid.Column="1" CornerRadius="3" Padding="4,1" Margin="0,0,10,0">
                                            <Border.Style>
                                                <Style TargetType="Border">
                                                    <Setter Property="Background" Value="{StaticResource LogLevelInfoBg}"/>
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding Level}" Value="ERROR">
                                                            <Setter Property="Background" Value="{StaticResource LogLevelErrorBg}"/>
                                                        </DataTrigger>
                                                        <DataTrigger Binding="{Binding Level}" Value="WARNING">
                                                            <Setter Property="Background" Value="{StaticResource LogLevelWarningBg}"/>
                                                        </DataTrigger>
                                                        <DataTrigger Binding="{Binding Level}" Value="DNS">
                                                            <Setter Property="Background" Value="{StaticResource LogLevelDnsBg}"/>
                                                        </DataTrigger>
                                                        <DataTrigger Binding="{Binding Level}" Value="BLOCKED">
                                                            <Setter Property="Background" Value="{StaticResource LogLevelBlockedBg}"/>
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </Border.Style>
                                            <TextBlock Text="{Binding Level}" FontSize="10" FontWeight="Bold" Foreground="White"/>
                                        </Border>
                                        <TextBlock Grid.Column="2" Text="{Binding Message}"
                                                   TextWrapping="Wrap">
                                            <TextBlock.Style>
                                                <Style TargetType="TextBlock">
                                                    <Setter Property="Foreground" Value="{StaticResource LogInfo}"/>
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding Level}" Value="ERROR">
                                                            <Setter Property="Foreground" Value="{StaticResource LogError}"/>
                                                        </DataTrigger>
                                                        <DataTrigger Binding="{Binding Level}" Value="WARNING">
                                                            <Setter Property="Foreground" Value="{StaticResource LogWarning}"/>
                                                        </DataTrigger>
                                                        <DataTrigger Binding="{Binding Level}" Value="DNS">
                                                            <Setter Property="Foreground" Value="{StaticResource LogDns}"/>
                                                        </DataTrigger>
                                                        <DataTrigger Binding="{Binding Level}" Value="BLOCKED">
                                                            <Setter Property="Foreground" Value="{StaticResource LogBlocked}"/>
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </TextBlock.Style>
                                        </TextBlock>
                                    </Grid>
                                </DataTemplate>
                            </ListBox.ItemTemplate>
                        </ListBox>
                    </Grid>

                    <!-- Control Panel Section (collapsible) -->
                    <Expander Grid.Row="1" Margin="0,0,0,5" IsExpanded="True"
                              BorderBrush="{StaticResource BorderBrush}" BorderThickness="1" Background="{StaticResource Surface}">
                        <Expander.Header>
                            <TextBlock Text="ПАНЕЛЬ УПРАВЛЕНИЯ" FontWeight="Bold" Padding="4,3"/>
                        </Expander.Header>
                        <Border Padding="10,6,10,8" Background="{StaticResource HeaderBackground}" CornerRadius="0,0,5,5">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>

                                <!-- Firewall Control -->
                                <StackPanel Grid.Column="0">
                                    <StackPanel Orientation="Horizontal" Margin="0,4">
                                        <Ellipse>
                                            <Ellipse.Style>
                                                <Style TargetType="Ellipse" BasedOn="{StaticResource StatusDot}">
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding FirewallRunning}" Value="True">
                                                            <Setter Property="Fill" Value="{StaticResource StatusRunning}"/>
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </Ellipse.Style>
                                        </Ellipse>
                                        <TextBlock Text="Firewall" FontWeight="SemiBold" VerticalAlignment="Center" Margin="0,0,10,0"/>
                                        <TextBlock VerticalAlignment="Center">
                                            <TextBlock.Style>
                                                <Style TargetType="TextBlock" BasedOn="{StaticResource {x:Type TextBlock}}">
                                                    <Setter Property="Text" Value="Остановлен"/>
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding FirewallRunning}" Value="True">
                                                            <Setter Property="Text" Value="Запущен"/>
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </TextBlock.Style>
                                        </TextBlock>
                                    </StackPanel>
                                    <StackPanel Orientation="Horizontal" Margin="0,6,0,0">
                                        <Button Content="Старт" Style="{StaticResource SmallButton}" Command="{Binding StartDaemonCommand}"/>
                                        <Button Content="Стоп" Style="{StaticResource SmallButton}" Command="{Binding StopDaemonCommand}"/>
                                        <Button Content="Рестарт" Style="{StaticResource SmallButton}" Command="{Binding RestartDaemonCommand}"/>
                                    </StackPanel>
                                </StackPanel>

                                <!-- Server Control -->
                                <StackPanel Grid.Column="1">
                                    <StackPanel Orientation="Horizontal" Margin="0,4">
                                        <Ellipse>
                                            <Ellipse.Style>
                                                <Style TargetType="Ellipse" BasedOn="{StaticResource StatusDot}">
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding ServerConnected}" Value="True">
                                                            <Setter Property="Fill" Value="{StaticResource StatusRunning}"/>
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </Ellipse.Style>
                                        </Ellipse>
                                        <TextBlock Text="Сервер" FontWeight="SemiBold" VerticalAlignment="Center" Margin="0,0,10,0"/>
                                        <TextBlock VerticalAlignment="Center">
                                            <TextBlock.Style>
                                                <Style TargetType="TextBlock" BasedOn="{StaticResource {x:Type TextBlock}}">
                                                    <Setter Property="Text" Value="Нет связи"/>
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding ServerConnected}" Value="True">
                                                            <Setter Property="Text" Value="Подключено"/>
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </TextBlock.Style>
                                        </TextBlock>
                                    </StackPanel>
                                    <StackPanel Orientation="Horizontal" Margin="0,6,0,0">
                                        <Button Content="Подключиться" Style="{StaticResource PrimaryButton}" Command="{Binding ConnectCommand}"/>
                                        <Button Content="Отключиться" Style="{StaticResource SmallButton}" Command="{Binding DisconnectCommand}"/>
                                    </StackPanel>
                                </StackPanel>

                                <!-- Filtration & Client -->
                                <StackPanel Grid.Column="2">
                                    <StackPanel Orientation="Horizontal" Margin="0,4">
                                        <TextBlock Text="Фильтрация" FontWeight="SemiBold" VerticalAlignment="Center" Margin="0,0,10,0"/>
                                        <TextBlock Text="Вкл" VerticalAlignment="Center">
                                            <TextBlock.Style>
                                                <Style TargetType="TextBlock" BasedOn="{StaticResource {x:Type TextBlock}}">
                                                    <Setter Property="Text" Value="Выкл"/>
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding FiltrationEnabled}" Value="True">
                                                            <Setter Property="Text" Value="Вкл"/>
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </TextBlock.Style>
                                        </TextBlock>
                                    </StackPanel>
                                    <StackPanel Orientation="Horizontal" Margin="0,6,0,0">
                                        <Button Content="Вкл/Выкл" Style="{StaticResource SmallButton}" Command="{Binding ToggleFiltrationCommand}" Margin="0,0,10,0"/>
                                        <Button Content="Рестарт клиента" Style="{StaticResource SmallButton}" Command="{Binding RestartClientCommand}"/>
                                    </StackPanel>
                                </StackPanel>
                            </Grid>
                        </Border>
                    </Expander>
                </Grid>

                <!-- SECTION: Whitelist -->
                <Grid>
                    <Grid.Style>
                        <Style TargetType="Grid">
                            <Setter Property="Visibility" Value="Collapsed"/>
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding SelectedSection}" Value="Whitelist">
                                    <Setter Property="Visibility" Value="Visible"/>
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </Grid.Style>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <Border Grid.Row="0" Background="{StaticResource HeaderBackground}" CornerRadius="4" Margin="0,0,0,5">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>

                            <TextBlock Grid.Column="0" FontWeight="Bold" Margin="10,5" VerticalAlignment="Center">
                                <Run Text="БЕЛЫЙ СПИСОК ("/>
                                <Run Text="{Binding WhitelistCount}"/>
                                <Run Text=" доменов)"/>
                            </TextBlock>

                            <TextBox Grid.Column="1" Margin="10,5"
                                     Text="{Binding WhitelistSearchText, UpdateSourceTrigger=PropertyChanged}"
                                     VerticalContentAlignment="Center"/>

                            <StackPanel Grid.Column="3" Orientation="Horizontal" Margin="5" VerticalAlignment="Center">
                                <TextBlock Text="Формат:" VerticalAlignment="Center" Margin="0,0,5,0"/>
                                <ComboBox Width="150" SelectedIndex="{Binding WhitelistFormatIndex}">
                                    <ComboBoxItem Content="Красивый"/>
                                    <ComboBoxItem Content="Исходный"/>
                                </ComboBox>
                            </StackPanel>

                            <Button Grid.Column="4" Content="Обновить"
                                    Style="{StaticResource ControlButton}" Command="{Binding RefreshStatusCommand}" Margin="5"/>
                        </Grid>
                    </Border>

                    <Grid Grid.Row="1">
                        <ListBox ItemsSource="{Binding FilteredWhitelist}"
                                 BorderBrush="{StaticResource BorderBrush}"
                                 FontFamily="Segoe UI" FontSize="13"
                                 ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                                 Visibility="{Binding ShowPrettyWhitelist, Converter={StaticResource BoolToVisibility}}">
                            <ListBox.ItemContainerStyle>
                                <Style TargetType="ListBoxItem">
                                    <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
                                    <Setter Property="Padding" Value="0"/>
                                </Style>
                            </ListBox.ItemContainerStyle>
                            <ListBox.ItemTemplate>
                                <DataTemplate>
                                    <StackPanel Orientation="Horizontal" Margin="5,8">
                                        <Ellipse Width="8" Height="8"
                                                 Fill="{StaticResource StatusRunning}"
                                                 VerticalAlignment="Center" Margin="0,0,15,0"/>
                                        <TextBlock Text="{Binding}" TextWrapping="Wrap"/>
                                    </StackPanel>
                                </DataTemplate>
                            </ListBox.ItemTemplate>
                        </ListBox>

                        <TextBox Text="{Binding RawWhitelistText, Mode=OneWay}"
                                 IsReadOnly="True"
                                 TextWrapping="Wrap"
                                 VerticalScrollBarVisibility="Auto"
                                 VerticalContentAlignment="Top"
                                 FontFamily="Consolas" FontSize="14"
                                 Background="{StaticResource LogBackground}"
                                 Foreground="{StaticResource LogInfo}"
                                 Padding="10"
                                 Visibility="{Binding ShowPrettyWhitelist, Converter={StaticResource InverseBoolToVisibility}}"/>
                    </Grid>
                </Grid>

                <!-- SECTION: Settings -->
                <Grid>
                    <Grid.Style>
                        <Style TargetType="Grid">
                            <Setter Property="Visibility" Value="Collapsed"/>
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding SelectedSection}" Value="Settings">
                                    <Setter Property="Visibility" Value="Visible"/>
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </Grid.Style>
                    <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <StackPanel Margin="10">
                        <StackPanel Visibility="{Binding SettingsAvailable, Converter={StaticResource BoolToVisibility}}">
                            <GroupBox Header="Сервер" Margin="0,0,0,10" Padding="10">
                                <StackPanel>
                                    <StackPanel Orientation="Horizontal" Margin="0,5">
                                        <TextBlock Text="Адрес сервера:" Width="120" VerticalAlignment="Center"/>
                                        <TextBox Text="{Binding ServerAddress, UpdateSourceTrigger=PropertyChanged}" Width="200" Margin="5,0"/>
                                    </StackPanel>
                                    <StackPanel Orientation="Horizontal" Margin="0,5">
                                        <TextBlock Text="Пользователь:" Width="120" VerticalAlignment="Center"/>
                                        <TextBox Text="{Binding Username, UpdateSourceTrigger=PropertyChanged}" Width="200" Margin="5,0"/>
                                        <Button Content="Зарегистрироваться" Style="{StaticResource PrimaryButton}" Command="{Binding RegisterCommand}" IsEnabled="{Binding CanRegister}" Padding="8,2" Margin="5,0,0,0"/>
                                    </StackPanel>
                                    <StackPanel Orientation="Horizontal" Margin="0,5">
                                        <TextBlock Text="Порт:" Width="120" VerticalAlignment="Center"/>
                                        <TextBox Text="{Binding ServerPort, UpdateSourceTrigger=PropertyChanged}" Width="100" Margin="5,0"/>
                                    </StackPanel>
                                    <Separator Margin="0,10"/>
                                    <StackPanel Orientation="Horizontal" Margin="0,5">
                                        <TextBlock Text="Сервер:" Width="120" VerticalAlignment="Center"/>
                                        <TextBlock Text="{Binding ServerName}" VerticalAlignment="Center" Margin="5,0"/>
                                        <TextBlock Text="(" VerticalAlignment="Center"/>
                                        <TextBlock Text="{Binding ServerAddress}" VerticalAlignment="Center" Foreground="Gray"/>
                                        <TextBlock Text=")" VerticalAlignment="Center"/>
                                        <Button Content="Сменить" Command="{Binding ChangeServerCommand}" Padding="8,2" Margin="10,0,0,0"/>
                                    </StackPanel>
                                </StackPanel>
                            </GroupBox>

                            <GroupBox Header="Белый список" Margin="0,0,0,10" Padding="10">
                                <StackPanel>
                                    <CheckBox IsChecked="{Binding FallbackWhitelistEnabled}"
                                              Content="Использовать локальный список при отключении синхронизации"
                                              Margin="0,5"/>
                                    <TextBlock TextWrapping="Wrap" Foreground="Gray" FontSize="11" Margin="20,0,0,0">
                                        <Run Text="При включении используется список из файла whitelist.txt, когда сервер не предоставляет список."/>
                                        <LineBreak/>
                                        <Run Text="При выключении весь трафик блокируется, если сервер не передал список разрешённых доменов."/>
                                    </TextBlock>
                                </StackPanel>
                            </GroupBox>

                            <GroupBox Header="Обнаружение сервера" Margin="0,0,0,10" Padding="10">
                                <StackPanel>
                                    <CheckBox IsChecked="{Binding DiscoveryEnabled}"
                                              Content="Автоматическое обнаружение сервера в сети"
                                              Margin="0,5"/>
                                    <TextBlock TextWrapping="Wrap" Foreground="Gray" FontSize="11" Margin="20,0,0,0">
                                        <Run Text="Отключите, если сервер использует статический IP. При отключении используйте ручной ввод адреса сервера."/>
                                    </TextBlock>
                                </StackPanel>
                            </GroupBox>

                            <GroupBox Header="Сеть" Margin="0,0,0,10" Padding="10">
                                <StackPanel>
                                    <CheckBox IsChecked="{Binding NetworkAuto}"
                                              Content="Автоматическое определение сети"
                                              Margin="0,5"/>
                                    <StackPanel Orientation="Horizontal" Margin="0,5">
                                        <TextBlock Text="Шлюз:" Width="120" VerticalAlignment="Center"/>
                                        <TextBox Text="{Binding NetworkGateway, UpdateSourceTrigger=PropertyChanged}" Width="200" Margin="5,0" IsEnabled="{Binding NetworkManualMode}"/>
                                    </StackPanel>
                                    <StackPanel Orientation="Horizontal" Margin="0,5">
                                        <TextBlock Text="Маска подсети:" Width="120" VerticalAlignment="Center"/>
                                        <TextBox Text="{Binding NetworkMask, UpdateSourceTrigger=PropertyChanged}" Width="200" Margin="5,0" IsEnabled="{Binding NetworkManualMode}"/>
                                    </StackPanel>
                                    <TextBlock TextWrapping="Wrap" Foreground="Gray" FontSize="11" Margin="20,0,0,0"
                                               Visibility="{Binding NetworkAuto, Converter={StaticResource BoolToVisibility}}">
                                        <Run Text="Автоматический режим. Отключите, чтобы задать шлюз и маску вручную."/>
                                    </TextBlock>
                                </StackPanel>
                            </GroupBox>

                            <GroupBox Header="Фильтрация" Margin="0,0,0,10" Padding="10">
                                <StackPanel>
                                    <CheckBox IsChecked="{Binding FiltrationAutoDisable}"
                                              Content="Авто-отключение при потере связи с сервером"
                                              Margin="0,5"/>
                                    <TextBlock TextWrapping="Wrap" Foreground="Gray" FontSize="11" Margin="20,0,0,0">
                                        <Run Text="При включении фильтрация автоматически отключается, когда клиент теряет соединение с сервером, и включается при восстановлении."/>
                                    </TextBlock>
                                </StackPanel>
                            </GroupBox>

                            <Button Content="Сохранить настройки" Style="{StaticResource PrimaryButton}" Command="{Binding SaveSettingsCommand}" IsEnabled="{Binding HasSettingsChanges}"
                                    HorizontalAlignment="Right" MinWidth="150" Padding="10,6" Margin="0,10"/>
                        </StackPanel>

                        <StackPanel Visibility="{Binding SettingsAvailable, Converter={StaticResource InverseBoolToVisibility}}">
                            <TextBlock Text="Нет соединения с Клиентом. Настройки не доступны."
                                       Foreground="Gray" FontSize="14" Margin="20"
                                       HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </StackPanel>
                    </StackPanel>
                </ScrollViewer>
                </Grid>
            </Grid>

            <!-- Side Navigation -->
            <Border Grid.Column="1" Background="{StaticResource SurfaceAlt}"
                    BorderBrush="{StaticResource BorderBrush}" BorderThickness="1" CornerRadius="4">
                <StackPanel Margin="8,10">
                    <TextBlock Text="РАЗДЕЛЫ" FontWeight="Bold" Foreground="{StaticResource TextDim}"
                               FontSize="11" Margin="6,0,0,8"/>

                    <RadioButton Content="Главная" GroupName="Nav"
                                 Style="{StaticResource NavItem}"
                                 IsChecked="{Binding SelectedSection, Converter={StaticResource EnumToBool}, ConverterParameter=Main}"/>
                    <RadioButton Content="Белый список" GroupName="Nav"
                                 Style="{StaticResource NavItem}"
                                 IsChecked="{Binding SelectedSection, Converter={StaticResource EnumToBool}, ConverterParameter=Whitelist}"/>
                    <RadioButton Content="Настройки" GroupName="Nav"
                                 Style="{StaticResource NavItem}"
                                 IsChecked="{Binding SelectedSection, Converter={StaticResource EnumToBool}, ConverterParameter=Settings}"/>
                </StackPanel>
            </Border>
        </Grid>

        <!-- Status Bar -->
        <Border Grid.Row="2" Background="{StaticResource HeaderBackground}"
                BorderThickness="0,1,0,0" BorderBrush="{StaticResource BorderBrush}">
            <DockPanel LastChildFill="False" Margin="8,4">
                <TextBlock DockPanel.Dock="Left" Text="{Binding OverallHealthText}" FontWeight="SemiBold" VerticalAlignment="Center"/>
                <Button DockPanel.Dock="Right" Content="Обновить" Style="{StaticResource SmallButton}"
                        Command="{Binding RefreshStatusCommand}"/>
                <TextBlock DockPanel.Dock="Right" Text="{Binding LastUpdateFormatted}" Foreground="{StaticResource TextDim}"
                           VerticalAlignment="Center" Margin="0,0,15,0"/>
            </DockPanel>
        </Border>
    </Grid>
</local:ChromeWindow>
