<UserControl x:Class="frontend.Views.ClientControlPanel"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <UserControl.Resources>
        <Style x:Key="SmallButton" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
            <Setter Property="Margin" Value="2"/>
            <Setter Property="MinWidth" Value="0"/>
            <Setter Property="Padding" Value="8,4"/>
            <Setter Property="FontSize" Value="{DynamicResource FontSize12}"/>
        </Style>
        <Style x:Key="StatusDot" TargetType="Ellipse">
            <Setter Property="Width" Value="12"/>
            <Setter Property="Height" Value="12"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="Fill" Value="{StaticResource StatusDisconnected}"/>
            <Setter Property="Margin" Value="0,0,8,0"/>
        </Style>
    </UserControl.Resources>
    <Grid Margin="10,6,10,8">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>
        <StackPanel Margin="0,0,12,12">
            <DockPanel>
                <Ellipse>
                    <Ellipse.Style>
                        <Style TargetType="Ellipse" BasedOn="{StaticResource StatusDot}">
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding Controls.BackendRunning}" Value="True">
                                    <Setter Property="Fill" Value="{StaticResource StatusRunning}"/>
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </Ellipse.Style>
                </Ellipse>
                <TextBlock Text="Клиентская служба" FontWeight="SemiBold" VerticalAlignment="Center" TextWrapping="Wrap"/>
            </DockPanel>
            <TextBlock x:Name="BackendStatus" Text="{Binding Controls.BackendStatusText}" TextWrapping="Wrap" Margin="0,4"/>
            <WrapPanel>
                <Button x:Name="StartBackend" Content="Старт" Style="{StaticResource SmallButton}"
                        Command="{Binding Controls.StartBackendCommand}" ToolTip="Запустить BigBrother Client. Firewall останется остановленным."/>
                <Button x:Name="StopBackend" Content="Стоп" Style="{StaticResource SmallButton}"
                        Command="{Binding Controls.StopBackendCommand}" ToolTip="Остановить BigBrother Client и Firewall. Интерфейс останется открытым."/>
                <Button x:Name="RestartBackend" Content="Рестарт" Style="{StaticResource SmallButton}"
                        Command="{Binding Controls.RestartBackendCommand}" ToolTip="Перезапустить BigBrother Client. Firewall останется остановленным."/>
            </WrapPanel>
        </StackPanel>
        <StackPanel Grid.Column="1" Margin="12,0,0,12">
            <DockPanel>
                <Ellipse>
                    <Ellipse.Style>
                        <Style TargetType="Ellipse" BasedOn="{StaticResource StatusDot}">
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding Controls.FirewallRunning}" Value="True">
                                    <Setter Property="Fill" Value="{StaticResource StatusRunning}"/>
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </Ellipse.Style>
                </Ellipse>
                <TextBlock Text="Firewall" FontWeight="SemiBold" VerticalAlignment="Center" TextWrapping="Wrap"/>
            </DockPanel>
            <TextBlock x:Name="FirewallStatus" Text="{Binding Controls.FirewallStatusText}" TextWrapping="Wrap" Margin="0,4"/>
            <WrapPanel>
                <Button x:Name="StartFirewall" Content="Старт" Style="{StaticResource SmallButton}" Command="{Binding Controls.StartFirewallCommand}"/>
                <Button x:Name="StopFirewall" Content="Стоп" Style="{StaticResource SmallButton}" Command="{Binding Controls.StopFirewallCommand}"/>
                <Button x:Name="RestartFirewall" Content="Рестарт" Style="{StaticResource SmallButton}" Command="{Binding Controls.RestartFirewallCommand}"/>
            </WrapPanel>
        </StackPanel>
        <StackPanel Grid.Row="1" Margin="0,0,12,0">
            <TextBlock Text="Сервер" FontWeight="SemiBold"/>
            <TextBlock Margin="0,4">
                <TextBlock.Style>
                    <Style TargetType="TextBlock" BasedOn="{StaticResource {x:Type TextBlock}}">
                        <Setter Property="Text" Value="Нет связи"/>
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding ServerConnected}" Value="True">
                                <Setter Property="Text" Value="Подключено"/>
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </TextBlock.Style>
            </TextBlock>
            <WrapPanel>
                <Button Content="Подключиться" Style="{StaticResource SmallButton}" Command="{Binding ConnectCommand}"/>
                <Button Content="Отключиться" Style="{StaticResource SmallButton}" Command="{Binding DisconnectCommand}"/>
            </WrapPanel>
        </StackPanel>
        <StackPanel Grid.Row="1" Grid.Column="1" Margin="12,0,0,0">
            <TextBlock Text="Фильтрация" FontWeight="SemiBold"/>
            <TextBlock Margin="0,4">
                <TextBlock.Style>
                    <Style TargetType="TextBlock" BasedOn="{StaticResource {x:Type TextBlock}}">
                        <Setter Property="Text" Value="Выкл"/>
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding FiltrationEnabled}" Value="True">
                                <Setter Property="Text" Value="Вкл"/>
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </TextBlock.Style>
            </TextBlock>
            <WrapPanel>
                <Button Content="Вкл/Выкл" Style="{StaticResource SmallButton}" Command="{Binding ToggleFiltrationCommand}"/>
            </WrapPanel>
        </StackPanel>
        <TextBlock Grid.Row="2" Grid.ColumnSpan="2" Text="{Binding Controls.OperationText}" TextWrapping="Wrap"/>
    </Grid>
</UserControl>
