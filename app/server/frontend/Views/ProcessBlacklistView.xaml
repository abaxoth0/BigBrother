<UserControl x:Class="frontend.Views.ProcessBlacklistView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <UserControl.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVisibility"/>
    </UserControl.Resources>
    <Grid Margin="8">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <TextBlock x:Name="EditorLabel" Text="Чёрный список приложений" FontWeight="SemiBold"
                   FontSize="{DynamicResource FontSize16}"/>
        <TextBlock Grid.Row="1" Margin="0,6,0,10" TextWrapping="Wrap"
                   Text="По одному имени .exe в строке. Например, game*.exe завершает подходящие процессы, а !game-editor.exe разрешает редактор. Выигрывает правило с большим приоритетом [N], при равенстве — исключение. Пустой список отключает блокировку."/>

        <TextBox Grid.Row="2" AutomationProperties.LabeledBy="{Binding ElementName=EditorLabel}"
                 Text="{Binding Text, UpdateSourceTrigger=PropertyChanged}" IsEnabled="{Binding CanEdit}"
                 AcceptsReturn="True" VerticalContentAlignment="Top" FontSize="{DynamicResource TextFontSize14}"
                 HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Auto"/>

        <DockPanel Grid.Row="3" Margin="0,8,0,0">
            <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                <Button Content="Повторить загрузку" Command="{Binding RetryCommand}" Margin="4,0"
                        Visibility="{Binding CanRetryLoad, Converter={StaticResource BoolToVisibility}}"/>
                <Button Content="Отмена" Command="{Binding CancelCommand}" Margin="4,0"/>
                <Button Content="Сохранить" Command="{Binding SaveCommand}" Style="{StaticResource PrimaryButton}"/>
            </StackPanel>
            <TextBlock Text="{Binding Status}" TextWrapping="Wrap" VerticalAlignment="Center"/>
        </DockPanel>
    </Grid>
</UserControl>
