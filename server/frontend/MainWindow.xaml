<local:ChromeWindow x:Class="frontend.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:frontend;assembly=BigBrother.Frontend.Shared"
        xmlns:vm="clr-namespace:frontend.ViewModels"
        xmlns:views="clr-namespace:frontend.Views"
        xmlns:conv="clr-namespace:frontend.Converters;assembly=BigBrother.Frontend.Shared"
        xmlns:shell="clr-namespace:System.Windows.Shell;assembly=PresentationFramework"
        mc:Ignorable="d"
        Title="BigBrother Сервер"
        Height="700" Width="1100"
        MinHeight="560" MinWidth="900"
        Background="{StaticResource WindowBackground}"
        Foreground="{StaticResource TitleBarText}"
        WindowStartupLocation="CenterScreen"
        WindowStyle="None">
    <shell:WindowChrome.WindowChrome>
        <shell:WindowChrome CaptionHeight="42" ResizeBorderThickness="6"
                            GlassFrameThickness="0" UseAeroCaptionButtons="False"/>
    </shell:WindowChrome.WindowChrome>

    <local:ChromeWindow.DataContext>
        <vm:MainViewModel/>
    </local:ChromeWindow.DataContext>

    <Window.Resources>
        <conv:BoolToVisibilityConverter x:Key="BoolToVisibility"/>
        <conv:InverseBoolToVisibilityConverter x:Key="InverseBoolToVisibility"/>
        <conv:EnumToBoolConverter x:Key="EnumToBool"/>

        <Style x:Key="UserRowStyle" TargetType="DataGridRow">
            <EventSetter Event="PreviewMouseLeftButtonDown" Handler="UserRow_PreviewMouseLeftButtonDown"/>
            <Style.Triggers>
                <DataTrigger Binding="{Binding IsSelected}" Value="True">
                    <Setter Property="Background" Value="{DynamicResource SelectedBackground}"/>
                </DataTrigger>
            </Style.Triggers>
        </Style>
        <Style x:Key="UserCellStyle" TargetType="DataGridCell" BasedOn="{StaticResource {x:Type DataGridCell}}">
            <Style.Triggers>
                <DataTrigger Binding="{Binding IsSelected}" Value="True">
                    <Setter Property="Background" Value="{DynamicResource SelectedBackground}"/>
                    <Setter Property="Foreground" Value="{DynamicResource AccentText}"/>
                </DataTrigger>
            </Style.Triggers>
        </Style>
        <DataTemplate x:Key="UserSelectionCellTemplate">
            <CheckBox IsChecked="{Binding IsSelected, UpdateSourceTrigger=PropertyChanged}"
                      Width="18" ClipToBounds="True"
                      HorizontalAlignment="Center" VerticalAlignment="Center"/>
        </DataTemplate>

        <Style x:Key="ControlButton" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
            <Setter Property="Padding" Value="10,5"/>
            <Setter Property="Margin" Value="2"/>
            <Setter Property="MinWidth" Value="70"/>
        </Style>
        <Style x:Key="SmallButton" TargetType="Button" BasedOn="{StaticResource ControlButton}">
            <Setter Property="MinWidth" Value="0"/>
            <Setter Property="Padding" Value="8,4"/>
            <Setter Property="FontSize" Value="12"/>
        </Style>

        <Style x:Key="StatusDot" TargetType="Ellipse">
            <Setter Property="Width" Value="12"/>
            <Setter Property="Height" Value="12"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="Fill" Value="{StaticResource StatusDisconnected}"/>
            <Setter Property="Margin" Value="0,0,8,0"/>
        </Style>

        <!-- Server log level colors + chips -->
        <SolidColorBrush x:Key="LogFatal" Color="#FF5555"/>
        <SolidColorBrush x:Key="LogDebug" Color="#04D9FF"/>
        <SolidColorBrush x:Key="LogTrace" Color="#4096A6"/>
        <SolidColorBrush x:Key="LogLevelFatalBg" Color="#99FF5555"/>
        <SolidColorBrush x:Key="LogLevelDebugBg" Color="#9904D9FF"/>
        <SolidColorBrush x:Key="LogLevelTraceBg" Color="#994096A6"/>

        <Style x:Key="FilterToggle" TargetType="ToggleButton">
            <Setter Property="Margin" Value="2"/>
            <Setter Property="Padding" Value="7,3"/>
            <Setter Property="MinWidth" Value="0"/>
            <Setter Property="FontSize" Value="11"/>
            <Setter Property="Background" Value="{StaticResource SurfaceAlt}"/>
            <Setter Property="Foreground" Value="{StaticResource TitleBarText}"/>
            <Setter Property="BorderBrush" Value="{StaticResource BorderBrush}"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ToggleButton">
                        <Border x:Name="Bd" Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="1"
                                CornerRadius="4" Padding="{TemplateBinding Padding}">
                            <ContentPresenter x:Name="Cp" HorizontalAlignment="Center" VerticalAlignment="Center"
                                              TextElement.Foreground="{TemplateBinding Foreground}"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="{StaticResource SurfaceAltHover}"/>
                            </Trigger>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="{StaticResource Accent}"/>
                                <Setter TargetName="Bd" Property="BorderBrush" Value="{StaticResource Accent}"/>
                                <Setter TargetName="Cp" Property="TextElement.Foreground" Value="{StaticResource OnAccent}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Custom Title Bar -->
        <Border Grid.Row="0" Background="{StaticResource TitleBarBackground}"
                BorderBrush="{StaticResource BorderBrush}" BorderThickness="0,0,0,1">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <TextBlock Grid.Column="0" Text="{Binding Title, RelativeSource={RelativeSource AncestorType=Window}}" Foreground="{StaticResource TitleBarText}"
                           FontSize="13" FontWeight="SemiBold" VerticalAlignment="Center" Margin="14,0,0,0"/>

                <StackPanel Grid.Column="2" Orientation="Horizontal">
                    <Button Content="&#x2013;"
                            Style="{StaticResource TitleBarButton}"
                            shell:WindowChrome.IsHitTestVisibleInChrome="True"
                            Click="MinimizeButton_Click"/>
                    <Button Content="&#x2715;"
                            Style="{StaticResource TitleBarButton}"
                            Tag="Close"
                            shell:WindowChrome.IsHitTestVisibleInChrome="True"
                            Click="CloseButton_Click"/>
                </StackPanel>
            </Grid>
        </Border>

        <!-- Content + Side Navigation -->
        <Grid Grid.Row="1" Margin="5">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="190"/>
            </Grid.ColumnDefinitions>

            <!-- Content area -->
            <Grid Grid.Column="0" Margin="0,0,8,0">

                <!-- SECTION: Main -->
                <Grid>
                    <Grid.Style>
                        <Style TargetType="Grid">
                            <Setter Property="Visibility" Value="Collapsed"/>
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding SelectedSection}" Value="Main">
                                    <Setter Property="Visibility" Value="Visible"/>
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </Grid.Style>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*" MinHeight="160"/>
                    </Grid.RowDefinitions>

                    <!-- Health / status banner -->
                    <Border Grid.Row="0" CornerRadius="4" Padding="12,8" Margin="0,0,0,8">
                        <Border.Style>
                            <Style TargetType="Border">
                                <Setter Property="Background" Value="{StaticResource StatusDisconnected}"/>
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding IsConnected}" Value="True">
                                        <Setter Property="Background" Value="{StaticResource StatusRunning}"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Border.Style>
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>

                            <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center" Margin="0,0,20,0">
                                <TextBlock Text="{Binding ServerStatus}" FontWeight="Bold" Foreground="White"
                                           VerticalAlignment="Center" FontSize="15"/>
                                <TextBlock Text="{Binding Uptime}" Foreground="#E6FFFFFF" FontSize="11"
                                           VerticalAlignment="Center" Margin="12,0,0,0"/>
                            </StackPanel>

                            <StackPanel Grid.Column="1" Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Center">
                                <TextBlock Text="Клиенты:" Foreground="White" FontSize="12" VerticalAlignment="Center"/>
                                <TextBlock Text="{Binding ConnectedClientsCount}" Foreground="White" FontSize="12" FontWeight="Bold"
                                           VerticalAlignment="Center" Margin="4,0,0,0"/>
                                <TextBlock Text="Ожидают:" Foreground="White" FontSize="12" VerticalAlignment="Center" Margin="20,0,0,0"/>
                                <TextBlock Text="{Binding PendingCount}" Foreground="White" FontSize="12" FontWeight="Bold"
                                           VerticalAlignment="Center" Margin="4,0,0,0"/>
                                <TextBlock Text="Фильтрация:" Foreground="White" FontSize="12" VerticalAlignment="Center" Margin="20,0,0,0"/>
                                <TextBlock Text="{Binding FiltrationStatus}" Foreground="White" FontSize="12" FontWeight="Bold"
                                           VerticalAlignment="Center" Margin="4,0,0,0"/>
                                <Button Content="Вкл/Выкл" Style="{StaticResource SmallButton}" FontSize="12"
                                        Command="{Binding ToggleFiltrationCommand}" Margin="8,0,0,0"/>
                            </StackPanel>

                            <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                                <TextBlock Text="Служба:" Foreground="#E6FFFFFF" FontSize="11" VerticalAlignment="Center"/>
                                <TextBlock Text="{Binding ServiceStatus}" Foreground="#E6FFFFFF" FontSize="11"
                                           VerticalAlignment="Center" Margin="4,0,10,0"/>
                                <Button Content="Пуск" Style="{StaticResource SmallButton}" Command="{Binding StartServiceCommand}"/>
                                <Button Content="Стоп" Style="{StaticResource SmallButton}" Command="{Binding StopServiceCommand}"/>
                                <Button Content="Рест" Style="{StaticResource SmallButton}" Command="{Binding RestartServiceCommand}"/>
                            </StackPanel>
                        </Grid>
                    </Border>

                    <!-- Log toolbar -->
                    <Border Grid.Row="1" Background="{StaticResource HeaderBackground}" CornerRadius="4" Margin="0,0,0,3">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                            </Grid.RowDefinitions>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>

                            <StackPanel Grid.Row="0" Grid.Column="0" Orientation="Horizontal" Margin="8,4" VerticalAlignment="Center">
                                <TextBlock Text="ЛОГИ" FontWeight="Bold" Margin="0,0,10,0" VerticalAlignment="Center"/>
                                <TextBox Text="{Binding LogSearchText, UpdateSourceTrigger=PropertyChanged}" Width="200"
                                         Height="24" FontSize="12" VerticalContentAlignment="Center"
                                         ToolTip="Поиск по тексту, уровню или источнику"/>
                                <CheckBox Content="Авто-скролл" IsChecked="{Binding AutoScroll}" Margin="10,0,0,0" VerticalAlignment="Center"/>
                                <Button Content="К последнему" Style="{StaticResource SmallButton}" Margin="6,0,0,0"
                                        Command="{Binding JumpToBottomCommand}"/>
                            </StackPanel>

                            <StackPanel Grid.Row="0" Grid.Column="1" Orientation="Horizontal" Margin="8,4" VerticalAlignment="Center">
                                <Button Content="Экспорт" Style="{StaticResource ControlButton}" Command="{Binding ExportServerLogsCommand}"/>
                                <Button Content="Очистить" Style="{StaticResource ControlButton}" Command="{Binding ClearServerLogsCommand}"/>
                            </StackPanel>

                            <StackPanel Grid.Row="1" Orientation="Horizontal" Margin="8,2" VerticalAlignment="Center">
                                <TextBlock Text="Уровень:" VerticalAlignment="Center" Margin="4,0" Foreground="{StaticResource TextDim}"/>
                                <ToggleButton Content="INFO" Style="{StaticResource FilterToggle}" IsChecked="{Binding ShowInfo}"/>
                                <ToggleButton Content="DEBUG" Style="{StaticResource FilterToggle}" IsChecked="{Binding ShowDebug}"/>
                                <ToggleButton Content="TRACE" Style="{StaticResource FilterToggle}" IsChecked="{Binding ShowTrace}"/>
                                <ToggleButton Content="WARNING" Style="{StaticResource FilterToggle}" IsChecked="{Binding ShowWarning}"/>
                                <ToggleButton Content="ERROR" Style="{StaticResource FilterToggle}" IsChecked="{Binding ShowError}"/>
                                <ToggleButton Content="FATAL" Style="{StaticResource FilterToggle}" IsChecked="{Binding ShowFatal}"/>
                            </StackPanel>
                        </Grid>
                    </Border>

                    <!-- Log entries list -->
                    <ListBox Grid.Row="2" x:Name="ServerLogListBox" ItemsSource="{Binding FilteredServerLogs}"
                             Background="{StaticResource LogBackground}"
                             FontFamily="Consolas" FontSize="12"
                             BorderBrush="{StaticResource BorderBrush}"
                             VirtualizingPanel.IsVirtualizing="True"
                             VirtualizingPanel.VirtualizationMode="Recycling">
                        <ListBox.ItemContainerStyle>
                            <Style TargetType="ListBoxItem">
                                <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
                                <Setter Property="Padding" Value="4,2"/>
                            </Style>
                        </ListBox.ItemContainerStyle>
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Grid.Column="0" Text="{Binding Timestamp}" Foreground="#8A8A8A" Margin="0,0,10,0"/>
                                    <Border Grid.Column="1" CornerRadius="3" Padding="4,1" Margin="0,0,10,0">
                                        <Border.Style>
                                            <Style TargetType="Border">
                                                <Setter Property="Background" Value="{StaticResource LogLevelInfoBg}"/>
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding Level}" Value="WARNING">
                                                        <Setter Property="Background" Value="{StaticResource LogLevelWarningBg}"/>
                                                    </DataTrigger>
                                                    <DataTrigger Binding="{Binding Level}" Value="ERROR">
                                                        <Setter Property="Background" Value="{StaticResource LogLevelErrorBg}"/>
                                                    </DataTrigger>
                                                    <DataTrigger Binding="{Binding Level}" Value="FATAL">
                                                        <Setter Property="Background" Value="{StaticResource LogLevelFatalBg}"/>
                                                    </DataTrigger>
                                                    <DataTrigger Binding="{Binding Level}" Value="DEBUG">
                                                        <Setter Property="Background" Value="{StaticResource LogLevelDebugBg}"/>
                                                    </DataTrigger>
                                                    <DataTrigger Binding="{Binding Level}" Value="TRACE">
                                                        <Setter Property="Background" Value="{StaticResource LogLevelTraceBg}"/>
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </Border.Style>
                                        <TextBlock Text="{Binding Level}" FontSize="10" FontWeight="Bold" Foreground="White"/>
                                    </Border>
                                    <TextBlock Grid.Column="2" Text="{Binding Message}" TextWrapping="Wrap">
                                        <TextBlock.Style>
                                            <Style TargetType="TextBlock">
                                                <Setter Property="Foreground" Value="{StaticResource LogInfo}"/>
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding Level}" Value="WARNING">
                                                        <Setter Property="Foreground" Value="{StaticResource LogWarning}"/>
                                                    </DataTrigger>
                                                    <DataTrigger Binding="{Binding Level}" Value="ERROR">
                                                        <Setter Property="Foreground" Value="{StaticResource LogError}"/>
                                                    </DataTrigger>
                                                    <DataTrigger Binding="{Binding Level}" Value="FATAL">
                                                        <Setter Property="Foreground" Value="{StaticResource LogFatal}"/>
                                                    </DataTrigger>
                                                    <DataTrigger Binding="{Binding Level}" Value="DEBUG">
                                                        <Setter Property="Foreground" Value="{StaticResource LogDebug}"/>
                                                    </DataTrigger>
                                                    <DataTrigger Binding="{Binding Level}" Value="TRACE">
                                                        <Setter Property="Foreground" Value="{StaticResource LogTrace}"/>
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </TextBlock.Style>
                                    </TextBlock>
                                </Grid>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>
                </Grid>

                <!-- SECTION: Users -->
                <Grid>
                    <Grid.Style>
                        <Style TargetType="Grid">
                            <Setter Property="Visibility" Value="Collapsed"/>
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding SelectedSection}" Value="Users">
                                    <Setter Property="Visibility" Value="Visible"/>
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </Grid.Style>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <Border Grid.Row="0" Background="{StaticResource HeaderBackground}" CornerRadius="4" Margin="0,0,0,5">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>

                            <TextBlock Grid.Column="0" Text="ПОЛЬЗОВАТЕЛИ" FontWeight="Bold" Margin="10,6" VerticalAlignment="Center"/>
                            <ComboBox Grid.Column="1" Width="220" SelectedIndex="{Binding UsersFilterIndex}" Margin="8,0,8,0">
                                <ComboBoxItem Content="Подключённые клиенты"/>
                                <ComboBoxItem Content="Ожидающие регистрации"/>
                                <ComboBoxItem Content="Все пользователи"/>
                            </ComboBox>
                            <TextBox Grid.Column="2" Text="{Binding UsersSearchText, UpdateSourceTrigger=PropertyChanged}"
                                     Margin="8,0,8,0" Height="26" VerticalContentAlignment="Center"
                                     ToolTip="Поиск по имени или адресу"/>
                            <Button Grid.Column="3" Content="Обновить" Style="{StaticResource ControlButton}" Command="{Binding RefreshCommand}" Margin="8,0,4,0"/>
                        </Grid>
                    </Border>

                    <!-- Connected clients -->
                    <DataGrid Grid.Row="1" ItemsSource="{Binding FilteredConnected}" AutoGenerateColumns="False"
                              RowStyle="{StaticResource UserRowStyle}" CellStyle="{StaticResource UserCellStyle}"
                              Background="{StaticResource Surface}" Foreground="{StaticResource TitleBarText}"
                              BorderBrush="{StaticResource BorderBrush}"
                              ColumnHeaderStyle="{StaticResource GridColumnHeaderStyle}"
                              Visibility="{Binding UsersShowConnected, Converter={StaticResource BoolToVisibility}}"
                              CanUserAddRows="False" CanUserDeleteRows="False" IsReadOnly="True"
                              RowBackground="{StaticResource Surface}"
                              AlternatingRowBackground="{StaticResource SurfaceAlt}"
                              HorizontalGridLinesBrush="{StaticResource BorderBrush}"
                              VerticalGridLinesBrush="{StaticResource BorderBrush}"
                              GridLinesVisibility="Horizontal" HeadersVisibility="Column"
                              VerticalContentAlignment="Center" MinRowHeight="26">
                        <DataGrid.Columns>
                            <DataGridTemplateColumn Header=" " Width="34" CellTemplate="{StaticResource UserSelectionCellTemplate}">
                                <DataGridTemplateColumn.HeaderTemplate>
                                    <DataTemplate>
                                        <CheckBox IsChecked="{Binding DataContext.AreAllConnectedSelected, RelativeSource={RelativeSource AncestorType=DataGrid}}"
                                                  Width="18" ClipToBounds="True" ToolTip="Выбрать всех подключённых клиентов"
                                                  HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                    </DataTemplate>
                                </DataGridTemplateColumn.HeaderTemplate>
                            </DataGridTemplateColumn>
                            <DataGridTextColumn Header="Имя" Binding="{Binding Name}" Width="150"/>
                            <DataGridTextColumn Header="Адрес" Binding="{Binding Address}" Width="150"/>
                            <DataGridTextColumn Header="Белый список" Binding="{Binding Whitelist}" Width="120"/>
                            <DataGridTextColumn Header="Фильтрация" Binding="{Binding FiltrationText}" Width="100"/>
                            <DataGridTextColumn Binding="{Binding Ipv6BlockText}" Width="145">
                                <DataGridTextColumn.Header>
                                    <TextBlock Text="Блокировка IPv6" ToolTip="Предпочтение клиента: блокировать IPv6 при включённой фильтрации"/>
                                </DataGridTextColumn.Header>
                            </DataGridTextColumn>
                            <DataGridTextColumn Binding="{Binding LastActivity, StringFormat=dd.MM.yyyy HH:mm:ss, TargetNullValue=—}" Width="170">
                                <DataGridTextColumn.Header>
                                    <TextBlock Text="Последняя активность" ToolTip="Время последнего сигнала от клиента"/>
                                </DataGridTextColumn.Header>
                            </DataGridTextColumn>
                        </DataGrid.Columns>
                        <DataGrid.ContextMenu>
                            <ContextMenu>
                                <MenuItem Header="Отключить" Command="{Binding DisconnectCommand}" CommandParameter="{Binding PlacementTarget.SelectedItem.Name, RelativeSource={RelativeSource AncestorType=ContextMenu}}"/>
                                <MenuItem Header="Включить блокировку IPv6" Command="{Binding EnableClientIpv6BlockCommand}"
                                          CommandParameter="{Binding PlacementTarget.SelectedItem, RelativeSource={RelativeSource AncestorType=ContextMenu}}"
                                          ToolTipService.ShowOnDisabled="True"
                                          ToolTip="Включить блокировку IPv6 у всех отмеченных клиентов; настройка сохраняется на каждом клиенте"/>
                                <MenuItem Header="Отключить блокировку IPv6" Command="{Binding DisableClientIpv6BlockCommand}"
                                          CommandParameter="{Binding PlacementTarget.SelectedItem, RelativeSource={RelativeSource AncestorType=ContextMenu}}"
                                          ToolTipService.ShowOnDisabled="True"
                                          ToolTip="Отключить блокировку IPv6 у всех отмеченных клиентов; настройка сохраняется на каждом клиенте"/>
                                <Separator/>
                                <MenuItem Header="Показать токен" Command="{Binding ShowUserTokenCommand}" CommandParameter="{Binding PlacementTarget.SelectedItem.Name, RelativeSource={RelativeSource AncestorType=ContextMenu}}"/>
                                <MenuItem Header="Сбросить токен" Command="{Binding RegenerateTokenCommand}" CommandParameter="{Binding PlacementTarget.SelectedItem.Name, RelativeSource={RelativeSource AncestorType=ContextMenu}}"/>
                            </ContextMenu>
                        </DataGrid.ContextMenu>
                    </DataGrid>

                    <DataGrid Grid.Row="1" ItemsSource="{Binding FilteredAllUsers}" AutoGenerateColumns="False"
                              RowStyle="{StaticResource UserRowStyle}" CellStyle="{StaticResource UserCellStyle}"
                              Background="{StaticResource Surface}" Foreground="{StaticResource TitleBarText}"
                              BorderBrush="{StaticResource BorderBrush}"
                              ColumnHeaderStyle="{StaticResource GridColumnHeaderStyle}"
                              Visibility="{Binding UsersShowAll, Converter={StaticResource BoolToVisibility}}"
                              CanUserAddRows="False" CanUserDeleteRows="False" IsReadOnly="True"
                              RowBackground="{StaticResource Surface}" AlternatingRowBackground="{StaticResource SurfaceAlt}"
                              HorizontalGridLinesBrush="{StaticResource BorderBrush}"
                              VerticalGridLinesBrush="{StaticResource BorderBrush}"
                              GridLinesVisibility="Horizontal" HeadersVisibility="Column"
                              VerticalContentAlignment="Center" MinRowHeight="26">
                        <DataGrid.Columns>
                            <DataGridTemplateColumn Header=" " Width="34" CellTemplate="{StaticResource UserSelectionCellTemplate}">
                                <DataGridTemplateColumn.HeaderTemplate>
                                    <DataTemplate>
                                        <CheckBox IsChecked="{Binding DataContext.AreAllUsersSelected, RelativeSource={RelativeSource AncestorType=DataGrid}}"
                                                  Width="18" ClipToBounds="True" ToolTip="Выбрать всех пользователей и все заявки"
                                                  HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                    </DataTemplate>
                                </DataGridTemplateColumn.HeaderTemplate>
                            </DataGridTemplateColumn>
                            <DataGridTextColumn Header="Имя" Binding="{Binding Name}" Width="180"/>
                            <DataGridTextColumn Header="Адрес" Binding="{Binding Address}" Width="180"/>
                            <DataGridTextColumn Header="Состояние" Binding="{Binding State}" Width="180"/>
                            <DataGridTextColumn Header="Последняя активность" Binding="{Binding LastActivity, StringFormat=dd.MM.yyyy HH:mm:ss, TargetNullValue=—}" Width="170"/>
                            <DataGridTextColumn Header="Запрошено" Binding="{Binding CreatedAt, StringFormat=dd.MM.yyyy HH:mm:ss, TargetNullValue=—}" Width="170"/>
                        </DataGrid.Columns>
                        <DataGrid.ContextMenu>
                            <ContextMenu>
                                <MenuItem Header="Одобрить" Command="{Binding ApproveCommand}" CommandParameter="{Binding PlacementTarget.SelectedItem.Pending.Name, RelativeSource={RelativeSource AncestorType=ContextMenu}}"/>
                                <MenuItem Header="Отклонить" Command="{Binding RejectCommand}" CommandParameter="{Binding PlacementTarget.SelectedItem.Pending.Name, RelativeSource={RelativeSource AncestorType=ContextMenu}}"/>
                                <Separator/>
                                <MenuItem Header="Отключить" Command="{Binding DisconnectCommand}" CommandParameter="{Binding PlacementTarget.SelectedItem.Client.Name, RelativeSource={RelativeSource AncestorType=ContextMenu}}"/>
                                <MenuItem Header="Включить блокировку IPv6" Command="{Binding EnableClientIpv6BlockCommand}" CommandParameter="{Binding PlacementTarget.SelectedItem.Client, RelativeSource={RelativeSource AncestorType=ContextMenu}}"/>
                                <MenuItem Header="Отключить блокировку IPv6" Command="{Binding DisableClientIpv6BlockCommand}" CommandParameter="{Binding PlacementTarget.SelectedItem.Client, RelativeSource={RelativeSource AncestorType=ContextMenu}}"/>
                                <Separator/>
                                <MenuItem Header="Показать токен" Command="{Binding ShowUserTokenCommand}" CommandParameter="{Binding PlacementTarget.SelectedItem.Client.Name, RelativeSource={RelativeSource AncestorType=ContextMenu}}"/>
                                <MenuItem Header="Сбросить токен" Command="{Binding RegenerateTokenCommand}" CommandParameter="{Binding PlacementTarget.SelectedItem.Client.Name, RelativeSource={RelativeSource AncestorType=ContextMenu}}"/>
                            </ContextMenu>
                        </DataGrid.ContextMenu>
                    </DataGrid>

                    <!-- Pending registrations -->
                    <DataGrid Grid.Row="1" ItemsSource="{Binding FilteredPending}" AutoGenerateColumns="False"
                              RowStyle="{StaticResource UserRowStyle}" CellStyle="{StaticResource UserCellStyle}"
                              Background="{StaticResource Surface}" Foreground="{StaticResource TitleBarText}"
                              BorderBrush="{StaticResource BorderBrush}"
                              ColumnHeaderStyle="{StaticResource GridColumnHeaderStyle}"
                              Visibility="{Binding UsersShowPending, Converter={StaticResource BoolToVisibility}}"
                              CanUserAddRows="False" CanUserDeleteRows="False" IsReadOnly="True"
                              RowBackground="{StaticResource Surface}"
                              AlternatingRowBackground="{StaticResource SurfaceAlt}"
                              HorizontalGridLinesBrush="{StaticResource BorderBrush}"
                              VerticalGridLinesBrush="{StaticResource BorderBrush}"
                              GridLinesVisibility="Horizontal" HeadersVisibility="Column"
                              VerticalContentAlignment="Center" MinRowHeight="26">
                        <DataGrid.Columns>
                            <DataGridTemplateColumn Header=" " Width="34" CellTemplate="{StaticResource UserSelectionCellTemplate}">
                                <DataGridTemplateColumn.HeaderTemplate>
                                    <DataTemplate>
                                        <CheckBox IsChecked="{Binding DataContext.AreAllPendingSelected, RelativeSource={RelativeSource AncestorType=DataGrid}}"
                                                  Width="18" ClipToBounds="True" ToolTip="Выбрать все заявки"
                                                  HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                    </DataTemplate>
                                </DataGridTemplateColumn.HeaderTemplate>
                            </DataGridTemplateColumn>
                            <DataGridTextColumn Header="Имя" Binding="{Binding Name}" Width="200"/>
                            <DataGridTextColumn Header="Адрес" Binding="{Binding Address}" Width="200"/>
                            <DataGridTextColumn Header="Запрошено" Binding="{Binding CreatedAt, StringFormat=yyyy-MM-dd HH:mm}" Width="180"/>
                        </DataGrid.Columns>
                        <DataGrid.ContextMenu>
                            <ContextMenu>
                                <MenuItem Header="Одобрить" Command="{Binding ApproveCommand}" CommandParameter="{Binding PlacementTarget.SelectedItem.Name, RelativeSource={RelativeSource AncestorType=ContextMenu}}"/>
                                <MenuItem Header="Отклонить" Command="{Binding RejectCommand}" CommandParameter="{Binding PlacementTarget.SelectedItem.Name, RelativeSource={RelativeSource AncestorType=ContextMenu}}"/>
                            </ContextMenu>
                        </DataGrid.ContextMenu>
                    </DataGrid>
                </Grid>

                <!-- SECTION: Lists -->
                <Grid>
                    <Grid.Style>
                        <Style TargetType="Grid">
                            <Setter Property="Visibility" Value="Collapsed"/>
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding SelectedSection}" Value="Lists">
                                    <Setter Property="Visibility" Value="Visible"/>
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </Grid.Style>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="5"/>
                        <RowDefinition Height="180" MinHeight="90"/>
                    </Grid.RowDefinitions>

                    <Border Grid.Row="0" Background="{StaticResource HeaderBackground}" CornerRadius="4" Margin="0,0,0,5">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                            </Grid.RowDefinitions>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <ComboBox Grid.Column="0" SelectedIndex="{Binding WhitelistTableIndex}" Margin="10,6" MinWidth="270"
                                      VerticalAlignment="Center" FontWeight="Bold">
                                <ComboBoxItem Content="{Binding ActiveWhitelistsText}"/>
                                <ComboBoxItem Content="{Binding ActiveTemporaryWhitelistsText}"/>
                            </ComboBox>
                            <Button Grid.Column="5" Content="Проверка домена" Style="{StaticResource ControlButton}"
                                    Command="{Binding OpenDomainCheckCommand}"/>
                            <Button Grid.Column="2" Content="Импорт" Style="{StaticResource ControlButton}" Command="{Binding ImportWhitelistsCommand}"/>
                            <Button Grid.Column="3" Content="Экспорт" Style="{StaticResource ControlButton}" Command="{Binding ExportWhitelistsCommand}"/>
                            <Button Grid.Column="4" Content="Создать" Style="{StaticResource ControlButton}" Command="{Binding OpenCreateWhitelistCommand}"/>
                            <Grid Grid.Row="1" Grid.ColumnSpan="6" Margin="10,2,6,6">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock Text="Изменения активности не сохранены. Проверка, синхронизация и конфликты используют сохранённый список."
                                           VerticalAlignment="Center" TextWrapping="Wrap" Margin="0,0,10,0"
                                           Visibility="{Binding HasWhitelistActivationChanges, Converter={StaticResource BoolToVisibility}}"/>
                                <StackPanel Grid.Column="1" Orientation="Horizontal" HorizontalAlignment="Right">
                                    <Button Content="Синхронизировать" Style="{StaticResource ControlButton}" Command="{Binding SyncWhitelistsCommand}"
                                            ToolTip="Проверить правила в клиентах и обновить только отличающиеся от сохранённого списка сервера"/>
                                    <Button Content="Сохранить" Style="{StaticResource ControlButton}" Command="{Binding SaveWhitelistActivationCommand}"/>
                                    <Button Content="Отмена" Style="{StaticResource ControlButton}" Command="{Binding CancelWhitelistActivationCommand}"/>
                                </StackPanel>
                            </Grid>
                        </Grid>
                    </Border>

                    <views:WhitelistTable Grid.Row="1" ItemsSource="{Binding RegularWhitelists}"
                                          Visibility="{Binding ShowRegularWhitelists, Converter={StaticResource BoolToVisibility}}"/>
                    <views:WhitelistTable Grid.Row="1" ItemsSource="{Binding TemporaryWhitelists}" IsTemporary="True"
                                          Visibility="{Binding ShowTemporaryWhitelists, Converter={StaticResource BoolToVisibility}}"/>
                    <GridSplitter Grid.Row="2" Height="5" HorizontalAlignment="Stretch" ResizeDirection="Rows">
                        <GridSplitter.Style>
                            <Style TargetType="GridSplitter">
                                <Setter Property="Background" Value="{StaticResource BorderBrush}"/>
                                <Setter Property="Template">
                                    <Setter.Value>
                                        <ControlTemplate TargetType="GridSplitter">
                                            <Border Background="{TemplateBinding Background}"/>
                                        </ControlTemplate>
                                    </Setter.Value>
                                </Setter>
                                <Style.Triggers>
                                    <Trigger Property="IsMouseOver" Value="True">
                                        <Setter Property="Background" Value="{StaticResource ScrollThumbBg}"/>
                                    </Trigger>
                                    <Trigger Property="IsKeyboardFocused" Value="True">
                                        <Setter Property="Background" Value="{StaticResource ScrollThumbHover}"/>
                                    </Trigger>
                                    <Trigger Property="IsDragging" Value="True">
                                        <Setter Property="Background" Value="{StaticResource ScrollThumbHover}"/>
                                    </Trigger>
                                </Style.Triggers>
                            </Style>
                        </GridSplitter.Style>
                    </GridSplitter>
                    <Grid Grid.Row="3">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                        </Grid.RowDefinitions>
                        <TextBlock Text="{Binding WhitelistConflictsText}" Margin="8,6" TextWrapping="Wrap"/>
                        <DataGrid Grid.Row="1" ItemsSource="{Binding WhitelistConflicts}" AutoGenerateColumns="False"
                                  IsReadOnly="True" CanUserAddRows="False" CanUserDeleteRows="False"
                                  Background="{StaticResource Surface}" Foreground="{StaticResource TitleBarText}"
                                  BorderBrush="{StaticResource BorderBrush}"
                                  ColumnHeaderStyle="{StaticResource GridColumnHeaderStyle}"
                                  RowBackground="{StaticResource Surface}" AlternatingRowBackground="{StaticResource SurfaceAlt}"
                                  HorizontalGridLinesBrush="{StaticResource BorderBrush}"
                                  GridLinesVisibility="Horizontal" HeadersVisibility="Column" MinRowHeight="26">
                            <DataGrid.Columns>
                                <DataGridTextColumn Header="Разрешение" Binding="{Binding AllowedRule}" Width="*"/>
                                <DataGridTextColumn Header="Списки" Binding="{Binding AllowedSources}" Width="*"/>
                                <DataGridTextColumn Header="Исключение" Binding="{Binding ExcludedRule}" Width="*"/>
                                <DataGridTextColumn Header="Списки" Binding="{Binding ExcludedSources}" Width="*"/>
                                <DataGridTextColumn Header="Результат" Binding="{Binding Resolution}" Width="100"/>
                            </DataGrid.Columns>
                        </DataGrid>
                    </Grid>
                </Grid>

                <!-- SECTION: Settings -->
                <Grid>
                    <Grid.Style>
                        <Style TargetType="Grid">
                            <Setter Property="Visibility" Value="Collapsed"/>
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding SelectedSection}" Value="Settings">
                                    <Setter Property="Visibility" Value="Visible"/>
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </Grid.Style>
                    <ScrollViewer VerticalScrollBarVisibility="Auto">
                        <StackPanel Margin="10">
                            <StackPanel Visibility="{Binding ConnectedVisibility}">
                                <GroupBox Header="Сервер" Margin="0,0,0,10" Padding="10">
                                    <StackPanel>
                                        <StackPanel Orientation="Horizontal" Margin="0,5">
                                            <TextBlock Text="Имя сервера:" Width="120" VerticalAlignment="Center"/>
                                            <TextBox Text="{Binding ServerName, UpdateSourceTrigger=PropertyChanged}" Width="220" Margin="5,0"/>
                                        </StackPanel>
                                        <StackPanel Orientation="Horizontal" Margin="0,5">
                                            <TextBlock Text="Порт:" Width="120" VerticalAlignment="Center"/>
                                            <TextBox Text="{Binding ServerPort, UpdateSourceTrigger=PropertyChanged}" Width="120" Margin="5,0"/>
                                        </StackPanel>
                                    </StackPanel>
                                </GroupBox>
                                <GroupBox Header="Сертификат сервера" Margin="0,0,0,10" Padding="10">
                                    <StackPanel>
                                        <TextBlock Text="SHA-256 действующего сертификата" Margin="0,0,0,5"/>
                                        <TextBox Text="{Binding CertificateFingerprint, Mode=OneWay}" IsReadOnly="True"
                                                 FontFamily="Consolas" TextWrapping="Wrap"/>
                                        <Button Content="Копировать отпечаток" Command="{Binding CopyCertificateFingerprintCommand}"
                                                HorizontalAlignment="Left" Margin="0,8,0,0"/>
                                        <TextBlock Text="После замены сертификата и перезапуска службы передайте этот отпечаток клиентам по доверенному каналу."
                                                   TextWrapping="Wrap" Foreground="{StaticResource TextDim}" Margin="0,8,0,0"/>
                                    </StackPanel>
                                </GroupBox>
                                <GroupBox Header="Обновления клиентов" Margin="0,0,0,12">
                                    <StackPanel Margin="12">
                                        <TextBlock Text="Сетевой путь к файлу обновления (\\сервер\общая_папка\обновление.exe)"/>
                                        <DockPanel Margin="0,6,0,8">
                                            <Button DockPanel.Dock="Right" Content="Обзор…" Command="{Binding BrowseClientUpdateCommand}" Margin="8,0,0,0"/>
                                            <Button DockPanel.Dock="Right" Content="Сетевая папка…" Command="{Binding OpenUpdateShareCommand}" Margin="8,0,0,0"/>
                                            <TextBox Text="{Binding ClientUpdateLocation, UpdateSourceTrigger=PropertyChanged}" VerticalContentAlignment="Center"/>
                                        </DockPanel>
                                        <TextBlock Text="Буква сетевого диска преобразуется в путь к общей папке. Если диск недоступен в «Обзоре», нажмите «Сетевая папка…». Рядом с файлом обновления должен находиться манифест (.manifest.json) из сборки. Клиенты копируют пакет локально перед установкой."
                                                   TextWrapping="Wrap" Foreground="{StaticResource TextDim}"/>
                                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,8,0,0">
                                            <Button Content="Убрать обновление" Command="{Binding ClearClientUpdateCommand}" Margin="0,0,8,0"/>
                                            <Button Content="Опубликовать" Command="{Binding PublishClientUpdateCommand}" Style="{StaticResource PrimaryButton}"/>
                                        </StackPanel>
                                        <TextBlock Text="{Binding ClientUpdateStatus}" TextWrapping="Wrap" Margin="0,8,0,0"/>
                                    </StackPanel>
                                </GroupBox>
                                <GroupBox Header="Временные списки" Margin="0,0,0,10" Padding="10">
                                    <StackPanel>
                                        <CheckBox IsChecked="{Binding SaveTemporaryWhitelistState}"
                                                  Content="Сохранять состояние временных списков при остановке сервера" Margin="0,5"/>
                                        <TextBlock Text="После запуска восстановятся активность и оставшееся время. Во время остановки таймеры не идут. Если настройка выключена, после запуска все временные списки выключены, а таймеры сброшены."
                                                   TextWrapping="Wrap" Foreground="{StaticResource TextDim}"/>
                                    </StackPanel>
                                </GroupBox>
                                <GroupBox Header="Уведомления" Margin="0,0,0,10" Padding="10">
                                    <CheckBox IsChecked="{Binding WindowsNotificationsEnabled}"
                                              Content="Показывать уведомления Windows" Margin="0,5"/>
                                </GroupBox>
                                <Button Content="Сохранить настройки" Style="{StaticResource PrimaryButton}" Command="{Binding SaveServerSettingsCommand}" IsEnabled="{Binding HasSettingsChanges}"
                                        HorizontalAlignment="Right" MinWidth="150" Padding="10,6"/>
                            </StackPanel>
                            <TextBlock Text="Нет соединения с Сервером. Настройки недоступны."
                                       Foreground="{StaticResource TextDim}" FontSize="14" Margin="20"
                                       Visibility="{Binding NotConnectedVisibility}"
                                       HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </StackPanel>
                    </ScrollViewer>
                </Grid>

            </Grid>

            <!-- Side Navigation -->
            <Border Grid.Column="1" Background="{StaticResource SurfaceAlt}"
                    BorderBrush="{StaticResource BorderBrush}" BorderThickness="1" CornerRadius="4">
                <Grid Margin="8,10">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>
                    <StackPanel VerticalAlignment="Top">
                        <TextBlock Text="Меню" FontWeight="Bold" Foreground="{StaticResource TextDim}"
                                   FontSize="11" Margin="6,0,0,8"/>

                        <RadioButton Content="Главная" GroupName="Nav"
                                     Style="{StaticResource NavItem}"
                                     IsChecked="{Binding SelectedSection, Converter={StaticResource EnumToBool}, ConverterParameter=Main}"/>
                        <RadioButton Content="Пользователи" GroupName="Nav"
                                     Style="{StaticResource NavItem}"
                                     IsChecked="{Binding SelectedSection, Converter={StaticResource EnumToBool}, ConverterParameter=Users}"/>
                        <RadioButton Content="Списки" GroupName="Nav"
                                     Style="{StaticResource NavItem}"
                                     IsChecked="{Binding SelectedSection, Converter={StaticResource EnumToBool}, ConverterParameter=Lists}"/>
                        <RadioButton Content="Настройки" GroupName="Nav"
                                     Style="{StaticResource NavItem}"
                                     IsChecked="{Binding SelectedSection, Converter={StaticResource EnumToBool}, ConverterParameter=Settings}"/>
                    </StackPanel>
                    <TextBlock Grid.Row="1" Foreground="{StaticResource TextDim}" FontSize="11" Margin="6,12,6,0" TextAlignment="Center">
                        <Run Text="Версия "/><Run Text="{x:Static local:BuildVersion.Current}"/>
                    </TextBlock>
                </Grid>
            </Border>
        </Grid>

        <!-- Status Bar -->
        <Border Grid.Row="2" Background="{StaticResource HeaderBackground}"
                BorderThickness="0,1,0,0" BorderBrush="{StaticResource BorderBrush}">
            <DockPanel LastChildFill="False" Margin="8,4">
                <TextBlock DockPanel.Dock="Left" Text="{Binding ServerStatus}" FontWeight="SemiBold" VerticalAlignment="Center"/>
                <TextBlock DockPanel.Dock="Left" Text="  |  " Foreground="{StaticResource TextDim}" VerticalAlignment="Center"/>
                <TextBlock DockPanel.Dock="Left" Text="{Binding UsersCounterText}" VerticalAlignment="Center"/>
                <Button DockPanel.Dock="Right" Content="Обновить" Style="{StaticResource SmallButton}"
                        Command="{Binding RefreshCommand}"/>
                <TextBlock DockPanel.Dock="Right" Text="{Binding LastUpdateFormatted}" Foreground="{StaticResource TextDim}"
                           VerticalAlignment="Center" Margin="0,0,15,0"/>
            </DockPanel>
        </Border>
    </Grid>
</local:ChromeWindow>
