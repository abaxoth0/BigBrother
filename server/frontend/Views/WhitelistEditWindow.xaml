<local:ChromeWindow x:Class="frontend.Views.WhitelistEditWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:frontend;assembly=BigBrother.Frontend.Shared"
        xmlns:shell="clr-namespace:System.Windows.Shell;assembly=PresentationFramework"
        mc:Ignorable="d"
        Title="{Binding WindowTitle}" Height="450" Width="520"
        WindowStartupLocation="CenterOwner"
        Background="{StaticResource WindowBackground}"
        Foreground="{StaticResource TitleBarText}"
        ResizeMode="NoResize"
        WindowStyle="None">
    <shell:WindowChrome.WindowChrome>
        <shell:WindowChrome CaptionHeight="42" ResizeBorderThickness="6"
                            GlassFrameThickness="0" UseAeroCaptionButtons="False"/>
    </shell:WindowChrome.WindowChrome>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- Custom Title Bar -->
        <Border Grid.Row="0" Background="{StaticResource TitleBarBackground}"
                BorderBrush="{StaticResource BorderBrush}" BorderThickness="0,0,0,1">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <TextBlock Grid.Column="0" Text="{Binding WindowTitle}" Foreground="{StaticResource TitleBarText}"
                           FontSize="13" FontWeight="SemiBold" VerticalAlignment="Center" Margin="14,0,0,0"/>
                <StackPanel Grid.Column="2" Orientation="Horizontal">
                    <Button Content="&#x2013;"
                            Style="{StaticResource TitleBarButton}"
                            shell:WindowChrome.IsHitTestVisibleInChrome="True"
                            Click="MinimizeButton_Click"/>
                    <Button Content="&#x2715;"
                            Style="{StaticResource TitleBarButton}"
                            Tag="Close"
                            shell:WindowChrome.IsHitTestVisibleInChrome="True"
                            Click="CloseButton_Click"/>
                </StackPanel>
            </Grid>
        </Border>

        <Grid Grid.Row="1" Margin="10">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <!-- Name Input -->
            <StackPanel Grid.Row="0" Orientation="Horizontal" Margin="0,0,0,10">
                <TextBlock Text="Название: " VerticalAlignment="Center" FontWeight="Bold"/>
                <TextBox Text="{Binding WhitelistName, UpdateSourceTrigger=PropertyChanged}" Width="300"/>
            </StackPanel>

            <!-- Entries Text Area -->
            <Grid Grid.Row="1">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

                <TextBlock Grid.Row="0" Text="Записи (по одной на строку):" FontWeight="Bold" Margin="0,0,0,5"/>
                <TextBox Grid.Row="1" Text="{Binding EntriesText, UpdateSourceTrigger=PropertyChanged}"
                         AcceptsReturn="True" VerticalScrollBarVisibility="Auto"
                         VerticalContentAlignment="Top"
                         FontFamily="Consolas" Padding="6"
                         Background="{StaticResource InputBackground}"
                         Foreground="{StaticResource TitleBarText}"
                         BorderBrush="{StaticResource BorderBrush}" BorderThickness="1"/>
            </Grid>

            <!-- Buttons -->
            <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,12,0,0">
                <Button Content="Сохранить" Style="{StaticResource PrimaryButton}" Width="90" Height="28" Margin="0,0,5,0"
                        Command="{Binding SaveCommand}" IsDefault="True"/>
                <Button Content="Отмена" Width="90" Height="28" IsCancel="True"/>
            </StackPanel>
        </Grid>
    </Grid>
</local:ChromeWindow>