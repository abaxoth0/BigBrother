<UserControl x:Class="frontend.Views.WhitelistActivationBar"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:conv="clr-namespace:frontend.Converters;assembly=BigBrother.Frontend.Shared">
    <UserControl.Resources>
        <conv:BoolToVisibilityConverter x:Key="BoolToVisibility"/>
    </UserControl.Resources>
    <Border x:Name="PendingChangesPanel" Background="{StaticResource HeaderBackground}" CornerRadius="4"
            Padding="10" Margin="0,6,0,0"
            Visibility="{Binding HasWhitelistActivationChanges, Converter={StaticResource BoolToVisibility}}">
        <StackPanel>
            <TextBlock Text="Есть несохранённые изменения активности." FontWeight="SemiBold" TextWrapping="Wrap"/>
            <TextBlock Text="Проверка, синхронизация и конфликты используют сохранённые правила."
                       Foreground="{StaticResource TextDim}" TextWrapping="Wrap" Margin="0,4,0,0"/>
            <WrapPanel HorizontalAlignment="Right" Margin="0,8,0,0">
                <Button x:Name="SaveActivationButton" Content="Сохранить" Style="{StaticResource PrimaryButton}"
                        Command="{Binding SaveWhitelistActivationCommand}" Margin="2" Padding="10,5"/>
                <Button x:Name="CancelActivationButton" Content="Отмена"
                        Command="{Binding CancelWhitelistActivationCommand}" Margin="2" Padding="10,5"/>
            </WrapPanel>
        </StackPanel>
    </Border>
</UserControl>
