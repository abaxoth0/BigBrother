<local:ChromeWindow x:Class="frontend.Views.WhitelistTimerWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:frontend;assembly=BigBrother.Frontend.Shared"
        xmlns:shell="clr-namespace:System.Windows.Shell;assembly=PresentationFramework"
        Title="Таймер временного списка" Width="520" SizeToContent="Height" ResizeMode="NoResize"
        WindowStartupLocation="CenterOwner" WindowStyle="None"
        Background="{StaticResource WindowBackground}" Foreground="{StaticResource TitleBarText}">
    <shell:WindowChrome.WindowChrome>
        <shell:WindowChrome CaptionHeight="42" ResizeBorderThickness="0" GlassFrameThickness="0" UseAeroCaptionButtons="False"/>
    </shell:WindowChrome.WindowChrome>
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>
        <Border Background="{StaticResource TitleBarBackground}" BorderBrush="{StaticResource BorderBrush}" BorderThickness="0,0,0,1">
            <Grid>
                <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                <TextBlock Text="Таймер временного списка" VerticalAlignment="Center" Margin="14,0" FontWeight="SemiBold"/>
                <Button Grid.Column="1" Content="&#x2715;" Style="{StaticResource TitleBarButton}" Tag="Close"
                        shell:WindowChrome.IsHitTestVisibleInChrome="True" Click="CloseButton_Click"/>
            </Grid>
        </Border>
        <StackPanel Grid.Row="1" Margin="16" x:Name="EditorPanel">
            <TextBlock x:Name="WhitelistName" FontWeight="Bold" TextWrapping="Wrap" Margin="0,0,0,6"/>
            <TextBlock x:Name="CurrentTimer" Text="{Binding RemainingText, StringFormat=Текущий таймер: {0}}" Margin="0,0,0,6"/>
            <Label Content="Начальное время (чч:мм:сс)" Target="{Binding ElementName=DurationInput}"/>
            <TextBox x:Name="DurationInput" Text="{Binding Duration, UpdateSourceTrigger=PropertyChanged}"/>
            <Label Content="Оставшееся время (чч:мм:сс)" Target="{Binding ElementName=RemainingInput}" Margin="0,8,0,0"/>
            <TextBox x:Name="RemainingInput" Text="{Binding Remaining, UpdateSourceTrigger=PropertyChanged}"/>
            <TextBlock Text="Таймер продолжает идти, пока открыто окно. Изменение начального времени прибавляет или вычитает разницу из текущего таймера. Изменение оставшегося времени задаёт его напрямую и не меняет начальное. Ноль завершает таймер."
                       TextWrapping="Wrap" Foreground="{StaticResource TextDim}" Margin="0,10"/>
            <CheckBox Content="Удалять список после истечения времени" IsChecked="{Binding AutoDelete}"/>
            <TextBlock Text="{Binding ValidationMessage}" TextWrapping="Wrap" Margin="0,10,0,0"/>
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,14,0,0">
                <Button Content="Сохранить" Click="Save_Click" IsEnabled="{Binding IsValid}" IsDefault="True"
                        Style="{StaticResource PrimaryButton}" MinWidth="95" Margin="0,0,8,0"/>
                <Button Content="Отмена" IsCancel="True" MinWidth="95"/>
            </StackPanel>
        </StackPanel>
    </Grid>
</local:ChromeWindow>
