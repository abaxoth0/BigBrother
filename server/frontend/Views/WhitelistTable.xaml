<UserControl x:Class="frontend.Views.WhitelistTable" x:Name="Root"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <DataGrid ItemsSource="{Binding ItemsSource, ElementName=Root}" AutoGenerateColumns="False"
              Background="{StaticResource Surface}" Foreground="{StaticResource TitleBarText}"
              BorderBrush="{StaticResource BorderBrush}"
              ColumnHeaderStyle="{StaticResource GridColumnHeaderStyle}"
              CanUserAddRows="False" CanUserDeleteRows="False"
              PreviewKeyDown="WhitelistTable_PreviewKeyDown"
              RowBackground="{StaticResource Surface}"
              AlternatingRowBackground="{StaticResource SurfaceAlt}"
              HorizontalGridLinesBrush="{StaticResource BorderBrush}"
              VerticalGridLinesBrush="{StaticResource BorderBrush}"
              GridLinesVisibility="Horizontal" HeadersVisibility="Column"
              VerticalContentAlignment="Center" MinRowHeight="26">
        <DataGrid.RowStyle>
            <Style TargetType="DataGridRow">
                <EventSetter Event="PreviewMouseLeftButtonDown" Handler="WhitelistRow_PreviewMouseLeftButtonDown"/>
                <EventSetter Event="MouseDoubleClick" Handler="WhitelistRow_MouseDoubleClick"/>
                <Style.Triggers>
                    <DataTrigger Binding="{Binding IsSelected}" Value="True">
                        <Setter Property="Background" Value="{DynamicResource SelectedBackground}"/>
                    </DataTrigger>
                </Style.Triggers>
            </Style>
        </DataGrid.RowStyle>
        <DataGrid.CellStyle>
            <Style TargetType="DataGridCell" BasedOn="{StaticResource {x:Type DataGridCell}}">
                <Style.Triggers>
                    <DataTrigger Binding="{Binding IsSelected}" Value="True">
                        <Setter Property="Background" Value="{DynamicResource SelectedBackground}"/>
                        <Setter Property="Foreground" Value="{DynamicResource AccentText}"/>
                    </DataTrigger>
                </Style.Triggers>
            </Style>
        </DataGrid.CellStyle>
        <DataGrid.Columns>
            <DataGridTemplateColumn Header=" " Width="34">
                <DataGridTemplateColumn.HeaderTemplate>
                    <DataTemplate>
                        <CheckBox IsChecked="{Binding DataContext.IsAllSelected, RelativeSource={RelativeSource AncestorType=DataGrid}}"
                                  Width="18" ClipToBounds="True"
                                  HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </DataTemplate>
                </DataGridTemplateColumn.HeaderTemplate>
                <DataGridTemplateColumn.CellTemplate>
                    <DataTemplate>
                        <Grid>
                            <CheckBox IsChecked="{Binding IsSelected, UpdateSourceTrigger=PropertyChanged}"
                                      Width="18" ClipToBounds="True"
                                      HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Grid>
                    </DataTemplate>
                </DataGridTemplateColumn.CellTemplate>
            </DataGridTemplateColumn>
            <DataGridTextColumn Header="Название" Binding="{Binding Name}" Width="200" IsReadOnly="True"/>
            <DataGridTextColumn Header="Записей" Binding="{Binding EntryCount}" Width="100" IsReadOnly="True"/>
            <DataGridTemplateColumn Header="Активный" Width="90" SortMemberPath="IsActive">
                <DataGridTemplateColumn.CellTemplate>
                    <DataTemplate>
                        <TextBlock HorizontalAlignment="Center" VerticalAlignment="Center">
                            <TextBlock.Style>
                                <Style TargetType="TextBlock">
                                    <Setter Property="Text" Value="Нет"/>
                                    <Setter Property="Foreground" Value="{StaticResource StatusDisconnected}"/>
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding IsActive}" Value="True">
                                            <Setter Property="Text" Value="Да"/>
                                            <Setter Property="Foreground" Value="{StaticResource StatusRunning}"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </TextBlock.Style>
                        </TextBlock>
                    </DataTemplate>
                </DataGridTemplateColumn.CellTemplate>
            </DataGridTemplateColumn>
            <DataGridTextColumn x:Name="DurationColumn" Header="Начальное время" Binding="{Binding DurationText}" Width="140" IsReadOnly="True"/>
            <DataGridTextColumn x:Name="RemainingColumn" Header="Осталось" Binding="{Binding RemainingText}" Width="110" IsReadOnly="True"/>
            <DataGridTextColumn x:Name="AutoDeleteColumn" Header="Автоудаление" Binding="{Binding AutoDeleteText}" Width="125" IsReadOnly="True"/>
        </DataGrid.Columns>
        <DataGrid.ContextMenu>
            <ContextMenu>
                <MenuItem Header="Включить" Command="{Binding EnableWhitelistsCommand}" CommandParameter="{Binding PlacementTarget.SelectedItem, RelativeSource={RelativeSource AncestorType=ContextMenu}}"/>
                <MenuItem Header="Выключить" Command="{Binding DisableWhitelistsCommand}" CommandParameter="{Binding PlacementTarget.SelectedItem, RelativeSource={RelativeSource AncestorType=ContextMenu}}"/>
                <MenuItem x:Name="EditTimerItem" Header="Таймер…" Command="{Binding EditWhitelistTimerCommand}" CommandParameter="{Binding PlacementTarget.SelectedItem, RelativeSource={RelativeSource AncestorType=ContextMenu}}"/>
                <MenuItem x:Name="ResetTimerItem" Header="Сбросить таймер" Command="{Binding ResetWhitelistTimersCommand}" CommandParameter="{Binding PlacementTarget.SelectedItem, RelativeSource={RelativeSource AncestorType=ContextMenu}}"/>
                <MenuItem Header="Редактировать" Command="{Binding OpenEditWhitelistCommand}" CommandParameter="{Binding PlacementTarget.SelectedItem, RelativeSource={RelativeSource AncestorType=ContextMenu}}"/>
                <Separator/>
                <MenuItem Header="Удалить" Command="{Binding DeleteSelectedWhitelistsCommand}" CommandParameter="{Binding PlacementTarget.SelectedItem, RelativeSource={RelativeSource AncestorType=ContextMenu}}"/>
            </ContextMenu>
        </DataGrid.ContextMenu>
    </DataGrid>
</UserControl>
