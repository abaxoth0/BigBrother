<UserControl x:Class="frontend.Views.WhitelistToolbar"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:views="clr-namespace:frontend.Views">
    <UserControl.Resources>
        <Style x:Key="ToolbarButton" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
            <Setter Property="Padding" Value="10,5"/>
            <Setter Property="Margin" Value="2"/>
        </Style>
        <Style x:Key="ActionGroup" TargetType="Border">
            <Setter Property="Background" Value="{StaticResource SurfaceAlt}"/>
            <Setter Property="CornerRadius" Value="4"/>
            <Setter Property="Padding" Value="8"/>
            <Setter Property="Margin" Value="0,0,8,6"/>
        </Style>
        <Style x:Key="GroupLabel" TargetType="TextBlock">
            <Setter Property="Foreground" Value="{StaticResource TextDim}"/>
            <Setter Property="FontSize" Value="{DynamicResource FontSize11}"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Margin" Value="2,0,2,6"/>
            <Setter Property="TextWrapping" Value="Wrap"/>
        </Style>
    </UserControl.Resources>
    <Border Background="{StaticResource HeaderBackground}" CornerRadius="4" Padding="8,8,0,2">
        <StackPanel>
            <ComboBox x:Name="ListTypeSelector" SelectedIndex="{Binding WhitelistTableIndex}"
                      HorizontalAlignment="Left"
                      Padding="12,7" Margin="2,0,8,10" FontWeight="Bold" AutomationProperties.Name="Тип белых списков">
                <ComboBox.ItemContainerStyle>
                    <Style TargetType="ComboBoxItem" BasedOn="{StaticResource {x:Type ComboBoxItem}}">
                        <Setter Property="Padding" Value="12,7"/>
                    </Style>
                </ComboBox.ItemContainerStyle>
                <ComboBoxItem Content="{Binding ActiveWhitelistsText}"/>
                <ComboBoxItem Content="{Binding ActiveTemporaryWhitelistsText}"/>
            </ComboBox>
            <WrapPanel>
                <Border x:Name="ListActions" Style="{StaticResource ActionGroup}">
                    <StackPanel>
                        <TextBlock Text="Списки" Style="{StaticResource GroupLabel}"/>
                        <WrapPanel>
                            <Button x:Name="CreateWhitelistButton" Content="Создать" Style="{StaticResource PrimaryButton}"
                                    Padding="10,5" Margin="2" Command="{Binding OpenCreateWhitelistCommand}"/>
                            <Button x:Name="ImportWhitelistsButton" Content="Импорт" Style="{StaticResource ToolbarButton}"
                                    Command="{Binding ImportWhitelistsCommand}"/>
                            <Button x:Name="ExportWhitelistsButton" Content="Экспорт" Style="{StaticResource ToolbarButton}"
                                    Command="{Binding ExportWhitelistsCommand}"/>
                        </WrapPanel>
                    </StackPanel>
                </Border>
                <Border x:Name="PresetActions" Style="{StaticResource ActionGroup}">
                    <StackPanel>
                        <TextBlock Text="Пресеты" Style="{StaticResource GroupLabel}"/>
                        <views:WhitelistPresetButtons x:Name="Presets"/>
                    </StackPanel>
                </Border>
                <Border x:Name="RuleTools" Style="{StaticResource ActionGroup}">
                    <StackPanel>
                        <TextBlock Text="Инструменты" Style="{StaticResource GroupLabel}"/>
                        <WrapPanel>
                            <Button x:Name="DomainCheckButton" Content="Проверка домена" Style="{StaticResource ToolbarButton}"
                                    Command="{Binding OpenDomainCheckCommand}"/>
                            <Button x:Name="SyncWhitelistsButton" Content="Синхронизировать" Style="{StaticResource ToolbarButton}"
                                    Command="{Binding SyncWhitelistsCommand}"
                                    ToolTip="Проверить правила в клиентах и обновить только отличающиеся от сохранённого списка сервера"/>
                        </WrapPanel>
                    </StackPanel>
                </Border>
            </WrapPanel>
        </StackPanel>
    </Border>
</UserControl>
